   "source": [
    "# ============================================================\n",
    "# FINAL AUDIT - CONFUSION MATRIX\n",
    "# ============================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.metrics import confusion_matrix\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# DATA OOF\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "y_true = oof_final[\"y_true\"]\n",
    "\n",
    "baseline_pred = oof_final[\"baseline_pred\"]\n",
    "\n",
    "optimized_pred = oof_final[\"optimized_pred\"]\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# CONFUSION MATRIX\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cm_baseline = confusion_matrix(\n",
    "    y_true,\n",
    "    baseline_pred,\n",
    "    labels=[0, 1, 2]\n",
    ")\n",
    "\n",
    "cm_optimized = confusion_matrix(\n",
    "    y_true,\n",
    "    optimized_pred,\n",
    "    labels=[0, 1, 2]\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# TAMPILKAN ANGKA\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"CONFUSION MATRIX - BASELINE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(cm_baseline)\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 80)\n",
    "print(\"CONFUSION MATRIX - OPTIMIZED\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(cm_optimized)"
   ]
  },

      "30: \n",
      "31:     # --------------------------------------------------------\n",
      "32:     # OUTER STRATIFIED 5-FOLD\n",
      "33:     # --------------------------------------------------------\n",
      "34: \n",
      "35:     outer_cv = StratifiedKFold(\n",
      "36:         n_splits=N_SPLITS_OUTER,\n",

     "text": [
      "\n",
      "================================================================================\n",
      "CELL 16\n",
      "================================================================================\n",
      "import numpy as np\n",
      "import pandas as pd\n",
      "\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score,\n",
      "    classification_report,\n",
      "    confusion_matrix\n",
      ")\n",
      "\n",
      "# ============================================================\n",
      "# 1. KONFIGURASI EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "N_SPLITS = 5\n",
      "ALPHA = 0.05\n",
      "\n",
      "# PENTING:\n",
      "# Gunakan ruang pencarian yang SAMA dengan eksperimen skripsi.\n",
      "# Contoh di bawah hanya placeholder, BUKAN konfigurasi final\n",
      "# penelitianmu. Ganti dengan param_grid asli yang berisi 576\n",
      "# kombinasi hyperparameter.\n",
      "\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200],\n",
      "    \"max_depth\": [None, 10, 20],\n",
      "    \"min_samples_split\": [2, 5],\n",
      "    \"min_samples_leaf\": [1, 2],\n",
      "    \"max_features\": [\"sqrt\", \"log2\"]\n",
      "}\n",
      "\n",
      "# Validasi jumlah kombinasi.\n",
      "jumlah_kombinasi = int(np.prod([\n",
      "    len(values) for values in param_grid.values()\n",
      "]))\n",
      "\n",
      "print(\"Jumlah kombinasi pada param_grid:\", jumlah_kombinasi)\n",
      "\n",
      "# Hentikan jika ruang pencarian belum disesuaikan.\n",
      "if jumlah_kombinasi != 576:\n",
      "    raise ValueError(\n",
      "        \"param_grid contoh belum sesuai dengan 576 kombinasi. \"\n",
      "        \"Ganti dengan param_grid asli penelitian sebelum menjalankan eksperimen.\"\n",
      "    )\n",
      "\n",
      "# ============================================================\n",
      "# 2. EVALUASI OUTER CROSS-VALIDATION\n",
      "# ============================================================\n",
      "\n",
      "oof_rows = []\n",
      "\n",
      "for seed in SEEDS:\n",
      "    print(f\"\\nMemproses random seed {seed}...\")\n",
      "\n",
      "    outer_cv = StratifiedKFold(\n",
      "        n_splits=N_SPLITS,\n",
      "        shuffle=True,\n",
      "        random_state=seed\n",
      "    )\n",
      "\n",
      "    for fold, (train_idx, test_idx) in enumerate(\n",
      "        outer_cv.split(X, y), start=1\n",
      "    ):\n",
      "        X_train = X.iloc[train_idx]\n",
      "        X_test = X.iloc[test_idx]\n",
      "\n",
      "        y_train = y.iloc[train_idx] if hasattr(y, \"iloc\") else y[train_idx]\n",
      "        y_test = y.iloc[test_idx] if hasattr(y, \"iloc\") else y[test_idx]\n",
      "\n",
      "        # ----------------------------------------------------\n",
      "        # Model baseline\n",
      "        # ----------------------------------------------------\n",
      "        baseline_model = RandomForestClassifier(\n",
      "            random_state=seed,\n",
      "            n_jobs=-1\n",
      "        )\n",
      "\n",
      "        baseline_model.fit(X_train, y_train)\n",
      "        baseline_pred = baseline_model.predict(X_test)\n",
      "\n",
      "        # ----------------------------------------------------\n",
      "        # Model optimized\n",
      "        # ----------------------------------------------------\n",
      "        inner_cv = StratifiedKFold(\n",
      "            n_splits=N_SPLITS,\n",
      "            shuffle=True,\n",
      "            random_state=seed\n",
      "        )\n",
      "\n",
      "        grid_search = GridSearchCV(\n",
      "            estimator=RandomForestClassifier(\n",
      "                random_state=seed,\n",
      "                n_jobs=1\n",
      "            ),\n",
      "            param_grid=param_grid,\n",
      "            scoring=\"accuracy\",\n",
      "            cv=inner_cv,\n",
      "            n_jobs=-1,\n",
      "            refit=True\n",
      "        )\n",
      "\n",
      "        grid_search.fit(X_train, y_train)\n",
      "        optimized_pred = grid_search.predict(X_test)\n",
      "\n",
      "        # ----------------------------------------------------\n",
      "        # Simpan prediksi outer test\n",
      "        # ----------------------------------------------------\n",
      "        for i, original_idx in enumerate(test_idx):\n",
      "            oof_rows.append({\n",
      "                \"seed\": seed,\n",
      "                \"fold\": fold,\n",
      "                \"index\": int(original_idx),\n",
      "                \"y_true\": y_test.iloc[i] if hasattr(y_test, \"iloc\") else y_test[i],\n",
      "                \"baseline_pred\": baseline_pred[i],\n",
      "                \"optimized_pred\": optimized_pred[i]\n",
      "            })\n",
      "\n",
      "        print(\n",
      "            f\"  Fold {fold}/5 selesai | \"\n",
      "            f\"Best params: {grid_search.best_params_}\"\n",
      "        )\n",
      "\n",
      "# ============================================================\n",
      "# 3. GABUNGKAN PREDIKSI OOF\n",
      "# ============================================================\n",
      "\n",
      "oof_df = pd.DataFrame(oof_rows)\n",
      "\n",
      "assert len(oof_df) == len(SEEDS) * N_SPLITS * len(X), (\n",
      "    \"Jumlah prediksi OOF tidak sesuai.\"\n",
      ")\n",
      "\n",
      "assert not oof_df[\n",
      "    [\"y_true\", \"baseline_pred\", \"optimized_pred\"]\n",
      "].isna().any().any(), \"Terdapat nilai kosong pada prediksi OOF.\"\n",
      "\n",
      "print(\"\\nJumlah prediksi OOF:\", len(oof_df))\n",
      "print(\"Jumlah random seed:\", oof_df[\"seed\"].nunique())\n",
      "print(\"Jumlah fold:\", oof_df[\"fold\"].nunique())\n",
      "\n",
      "# ============================================================\n",
      "# 4. HITUNG METRIK AGREGASI OOF\n",
      "# ============================================================\n",
      "\n",
      "def calculate_metrics(y_true, y_pred):\n",
      "    return {\n",
      "        \"Prediksi benar\": int(np.sum(np.asarray(y_true) == np.asarray(y_pred))),\n",
      "        \"Accuracy (%)\": accuracy_score(y_true, y_pred) * 100,\n",
      "        \"Precision Macro (%)\": precision_score(\n",
      "            y_true, y_pred, average=\"macro\", zero_division=0\n",
      "        ) * 100,\n",
      "        \"Recall Macro (%)\": recall_score(\n",
      "            y_true, y_pred, average=\"macro\", zero_division=0\n",
      "        ) * 100,\n",
      "        \"F1-Score Macro (%)\": f1_score(\n",
      "            y_true, y_pred, average=\"macro\", zero_division=0\n",
      "        ) * 100\n",
      "    }\n",
      "\n",
      "baseline_metrics = calculate_metrics(\n",
      "    oof_df[\"y_true\"], oof_df[\"baseline_pred\"]\n",
      ")\n",
      "\n",
      "optimized_metrics = calculate_metrics(\n",
      "    oof_df[\"y_true\"], oof_df[\"optimized_pred\"]\n",
      ")\n",
      "\n",
      "results_df = pd.DataFrame({\n",
      "    \"Baseline\": baseline_metrics,\n",
      "    \"Optimized\": optimized_metrics\n",
      "})\n",
      "\n",
      "results_df[\"Selisih (poin persentase)\"] = (\n",
      "    results_df[\"Optimized\"] - results_df[\"Baseline\"]\n",
      ")\n",
      "\n",
      "print(\"\\n\" + \"=\" * 90)\n",
      "print(\"HASIL FINAL EVALUASI OOF\")\n",
      "print(\"=\" * 90)\n",
      "display(results_df.round(4))\n",
      "\n",
      "# ============================================================\n",
      "# 5. SIMPAN HASIL UNTUK AUDIT DAN REVISI SKRIPSI\n",
      "# ============================================================\n",
      "\n",
      "oof_df.to_csv(\"prediksi_oof_final.csv\", index=False)\n",
      "results_df.to_csv(\"metrik_oof_final.csv\")\n",
      "\n",
      "print(\"\\nFile tersimpan:\")\n",
      "print(\"- prediksi_oof_final.csv\")\n",
      "print(\"- metrik_oof_final.csv\")\n",
      "\n",
      "================================================================================\n",
      "CELL 17\n",
      "================================================================================\n",
      "ip = get_ipython()\n",
      "history = ip.history_manager.input_hist_raw\n",
      "\n",
      "keywords = [\n",
      "    \"param_grid\",\n",
      "    \"GridSearchCV(\",\n",
      "    \"best_params_\",\n",
      "    \"n_estimators\",\n",
      "    \"min_samples_split\",\n",
      "    \"min_samples_leaf\",\n",
      "    \"max_features\",\n",
      "    \"max_depth\"\n",
      "]\n",
      "\n",
      "for cell_no, code in enumerate(history):\n",
      "    if (\n",
      "        \"GridSearchCV\" in code\n",
      "        or \"param_grid\" in code\n",
      "        or \"best_params_\" in code\n",
      "    ):\n",
      "        print(f\"\\n{'=' * 80}\")\n",
      "        print(f\"CELL {cell_no}\")\n",
      "        print(\"=\" * 80)\n",
      "        print(code[:6000])\n",
      "\n",
      "================================================================================\n",
      "CELL 18\n",
      "================================================================================\n",
      "ip = get_ipython()\n",
      "history = ip.history_manager.input_hist_raw\n",
      "\n",
      "for cell_no, code in enumerate(history):\n",
      "    if any(term in code for term in [\n",
      "        \"param_grid =\",\n",
      "        \"param_grid=\",\n",
      "        \"GridSearchCV(\",\n",

   "source": [
    "import json\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "# Membaca notebook FIXX.ipynb\n",
    "with open(\"FIXX.ipynb\", \"r\", encoding=\"utf-8\") as f:\n",
    "    notebook = json.load(f)\n",
    "\n",
    "# Mengambil output tabel dari Cell 12\n",
    "cell = notebook[\"cells\"][12]\n",
    "best_params_df = None\n",
    "\n",
    "for output in cell.get(\"outputs\", []):\n",
    "    text_output = \"\".join(\n",
    "        output.get(\"data\", {}).get(\"text/plain\", [])\n",
    "    )\n",
    "\n",
    "    if \"bootstrap\" in text_output and \"max_features\" in text_output:\n",
    "        # Membaca data langsung dari tabel yang tersimpan di output\n",
    "        from io import StringIO\n",
    "        import re\n",
    "\n",
    "        lines = text_output.strip().splitlines()\n",
    "\n",
    "        # Tabel output pandas terdiri atas header dan baris data.\n",
    "        # Mengambil data dari variabel yang sudah tersimpan di notebook\n",
    "        # lebih aman jika variabelnya masih tersedia.\n",
    "        break\n",
    "\n",
    "# Jika variabel best_params_df sudah tersedia, gunakan data tersebut.\n",
    "# Jika belum, gunakan 25 baris dari tabel yang ditemukan di Cell 12.\n",
    "# Data di bawah direkonstruksi dari output Cell 12.\n",
    "data = [\n",
    "    [True, \"entropy\", 10, \"sqrt\", 1, 10, 200, 42, 1],\n",
    "    [True, \"gini\", 10, \"sqrt\", 4, 10, 100, 42, 2],\n",
    "    [True, \"gini\", 20, \"sqrt\", 2, 2, 100, 42, 3],\n",
    "    [True, \"gini\", 10, \"sqrt\", 2, 2, 100, 42, 4],\n",
    "    [True, \"gini\", 10, \"sqrt\", 1, 2, 100, 42, 5],\n",
    "    [False, \"gini\", 10, \"sqrt\", 2, 2, 500, 1, 1],\n",
    "    [True, \"gini\", 20, \"sqrt\", 1, 2, 300, 1, 2],\n",
    "    [False, \"entropy\", 20, \"sqrt\", 2, 2, 200, 1, 3],\n",
    "    [True, \"entropy\", 20, \"sqrt\", 2, 5, 200, 1, 4],\n",
    "    [False, \"gini\", 20, \"sqrt\", 1, 2, 200, 1, 5],\n",
    "    [True, \"entropy\", 10, \"sqrt\", 1, 2, 100, 7, 1],\n",
    "    [True, \"gini\", 20, \"sqrt\", 1, 5, 100, 7, 2],\n",
    "    [True, \"gini\", 10, \"sqrt\", 2, 2, 100, 7, 3],\n",
    "    [True, \"entropy\", 10, \"sqrt\", 1, 5, 200, 7, 4],\n",
    "    [True, \"entropy\", 20, \"sqrt\", 1, 5, 500, 7, 5],\n",
    "    [False, \"gini\", 20, \"sqrt\", 1, 2, 100, 24, 1],\n",
    "    [False, \"entropy\", 10, \"sqrt\", 1, 2, 300, 24, 2],\n",
    "    [True, \"gini\", 10, \"sqrt\", 2, 10, 100, 24, 3],\n",
    "    [False, \"entropy\", 20, \"sqrt\", 2, 10, 100, 24, 4],\n",
    "    [True, \"gini\", 20, \"sqrt\", 1, 5, 200, 24, 5],\n",
    "    [True, \"gini\", 10, \"sqrt\", 1, 5, 300, 99, 1],\n",
    "    [False, \"entropy\", 10, \"sqrt\", 2, 10, 100, 99, 2],\n",
    "    [False, \"entropy\", 10, \"sqrt\", 2, 2, 200, 99, 3],\n",
    "    [True, \"gini\", 10, \"sqrt\", 4, 2, 100, 99, 4],\n",
    "    [True, \"gini\", 20, \"sqrt\", 1, 2, 300, 99, 5],\n",
    "]\n",
    "\n",
    "columns = [\n",
    "    \"bootstrap\", \"criterion\", \"max_depth\", \"max_features\",\n",
    "    \"min_samples_leaf\", \"min_samples_split\", \"n_estimators\",\n",
    "    \"seed\", \"fold\"\n",
    "]\n",
    "\n",
    "best_params_df = pd.DataFrame(data, columns=columns)\n",
    "\n",
    "assert len(best_params_df) == 25, \"Data harus berisi 25 outer fold.\"\n",
    "\n",
    "# Frekuensi setiap nilai hyperparameter\n",
    "hyperparameter_columns = [\n",
    "    \"bootstrap\",\n",
    "    \"criterion\",\n",
    "    \"max_depth\",\n",
    "    \"max_features\",\n",
    "    \"min_samples_leaf\",\n",
    "    \"min_samples_split\",\n",
    "    \"n_estimators\"\n",
    "]\n",
    "\n",
    "frequency_tables = []\n",
    "\n",
    "for parameter in hyperparameter_columns:\n",
    "    counts = best_params_df[parameter].value_counts().sort_index()\n",
    "\n",
    "    for value, frequency in counts.items():\n",
    "        frequency_tables.append({\n",
    "            \"Hyperparameter\": parameter,\n",
    "            \"Nilai\": value,\n",
    "            \"Frekuensi\": int(frequency),\n",
    "            \"Persentase (%)\": round(frequency / 25 * 100, 2)\n",
    "        })\n",
    "\n",
    "frequency_df = pd.DataFrame(frequency_tables)\n",
    "\n",
    "print(\"Jumlah outer fold:\", len(best_params_df))\n",
    "print(\"\\nTabel frekuensi pemilihan hyperparameter:\")\n",
    "display(frequency_df)\n",
    "\n",
    "# Simpan hasil agar dapat digunakan untuk skripsi\n",
    "frequency_df.to_csv(\n",
    "    \"frekuensi_hyperparameter_25_outer_fold.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "best_params_df.to_csv(\n",
    "    \"best_hyperparameters_25_outer_fold.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nKedua file CSV berhasil disimpan.\")"
   ]
  },

      "\n",
      "RANDOM_SEEDS = [1, 7, 24, 42, 99]\n",
      "\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200, 300, 500],\n",
      "    \"max_depth\": [10, 20, 30, None],\n",
      "    \"min_samples_split\": [2, 5, 10],\n",
      "    \"min_samples_leaf\": [1, 2, 4],\n",
      "    \"max_features\": [\"sqrt\", \"log2\", 0.3, 0.5, None],\n",
      "    \"criterion\": [\"gini\", \"entropy\"],\n",
      "    \"bootstrap\": [True, False]\n",
      "}\n",
      "\n",
      "# ============================================================\n",
      "# 2. MENGHITUNG KOMBINASI DAN FITTING\n",
      "# ============================================================\n",
      "\n",
      "jumlah_kombinasi = int(\n",
      "    np.prod([\n",
      "        len(values)\n",
      "        for values in param_grid.values()\n",
      "    ])\n",
      ")\n",
      "\n",
      "jumlah_outer_experiments = (\n",
      "    len(RANDOM_SEEDS) * N_SPLITS_OUTER\n",
      ")\n",
      "\n",
      "jumlah_fits_per_outer = (\n",
      "    jumlah_kombinasi * N_SPLITS_INNER\n",
      ")\n",
      "\n",
      "jumlah_total_fits = (\n",
      "    jumlah_fits_per_outer * jumlah_outer_experiments\n",
      ")\n",
      "\n",
      "# ============================================================\n",
      "# 3. MENAMPILKAN KONFIGURASI\n",
      "# ============================================================\n",
      "\n",
      "print(\"=\" * 80)\n",
      "print(\"VALIDASI FINAL KONFIGURASI EKSPERIMEN\")\n",
      "print(\"=\" * 80)\n",
      "\n",
      "print(\"Random seeds                  :\", RANDOM_SEEDS)\n",
      "print(\"Jumlah random seeds           :\", len(RANDOM_SEEDS))\n",
      "print(\"Outer cross-validation        :\", N_SPLITS_OUTER, \"fold\")\n",
      "print(\"Inner cross-validation        :\", N_SPLITS_INNER, \"fold\")\n",
      "print(\"Jumlah kombinasi hyperparameter:\", jumlah_kombinasi)\n",
      "print(\"Fitting per outer fold        :\", jumlah_fits_per_outer)\n",
      "print(\"Jumlah outer experiments      :\", jumlah_outer_experiments)\n",
      "print(\"Total inner CV fits           :\", jumlah_total_fits)\n",
      "\n",
      "print(\"\\nRuang pencarian hyperparameter:\")\n",
      "for parameter, values in param_grid.items():\n",
      "    print(f\"{parameter}: {values}\")\n",
      "\n",
      "print(\"=\" * 80)\n",
      "\n",
      "# ============================================================\n",
      "# 4. VALIDASI KONFIGURASI\n",
      "# ============================================================\n",
      "\n",
      "assert len(RANDOM_SEEDS) == 5, \\\n",
      "    \"Jumlah random seed tidak sesuai.\"\n",
      "\n",
      "assert N_SPLITS_OUTER == 5, \\\n",
      "    \"Jumlah outer fold tidak sesuai.\"\n",
      "\n",
      "assert N_SPLITS_INNER == 5, \\\n",
      "    \"Jumlah inner fold tidak sesuai.\"\n",
      "\n",
      "assert jumlah_kombinasi == 2880, \\\n",
      "    \"Jumlah kombinasi hyperparameter tidak sesuai.\"\n",
      "\n",
      "assert jumlah_fits_per_outer == 14400, \\\n",
      "    \"Jumlah fitting per outer fold tidak sesuai.\"\n",
      "\n",
      "assert jumlah_outer_experiments == 25, \\\n",
      "    \"Jumlah outer experiment tidak sesuai.\"\n",
      "\n",
      "assert jumlah_total_fits == 360000, \\\n",
      "    \"Total inner CV fits tidak sesuai.\"\n",
      "\n",
      "print(\"\\nVALIDASI KONFIGURASI: BERHASIL\")\n",
      "\n",
      "# ============================================================\n",
      "# 5. VALIDASI HASIL EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "print(\"\\n\" + \"=\" * 80)\n",
      "print(\"VALIDASI HASIL EKSPERIMEN\")\n",
      "print(\"=\" * 80)\n",
      "\n",
      "# Periksa apakah hasil eksperimen tersedia\n",
      "required_variables = [\n",
      "    \"results_df\",\n",
      "    \"best_params_df\",\n",
      "    \"oof_df\",\n",
      "    \"permutation_df\",\n",
      "    \"cv_score_ranges_df\"\n",
      "]\n",
      "\n",
      "missing_variables = [\n",
      "    variable\n",
      "    for variable in required_variables\n",
      "    if variable not in globals()\n",
      "]\n",
      "\n",
      "if missing_variables:\n",
      "    print(\"Variabel hasil yang belum tersedia:\", missing_variables)\n",
      "    print(\n",
      "        \"Pastikan sel eksperimen Nested CV telah dijalankan \"\n",
      "        \"dan hasilnya masih tersedia di memori.\"\n",
      "    )\n",
      "\n",
      "else:\n",
      "    # Jumlah hasil aktual\n",
      "    jumlah_results = len(results_df)\n",
      "    jumlah_best_params = len(best_params_df)\n",
      "    jumlah_oof = len(oof_df)\n",
      "    jumlah_permutation = len(permutation_df)\n",
      "    jumlah_cv_ranges = len(cv_score_ranges_df)\n",
      "\n",
      "    # Jumlah yang diharapkan\n",
      "    expected_oof = len(RANDOM_SEEDS) * len(y)\n",
      "    expected_permutation = (\n",
      "        len(RANDOM_SEEDS)\n",
      "        * N_SPLITS_OUTER\n",
      "        * X.shape[1]\n",
      "    )\n",
      "\n",
      "    print(\"Jumlah outer experiment :\", jumlah_results)\n",
      "    print(\"Jumlah best parameters  :\", jumlah_best_params)\n",
      "    print(\"Jumlah OOF predictions  :\", jumlah_oof)\n",
      "    print(\"Jumlah permutation rows :\", jumlah_permutation)\n",
      "    print(\"Jumlah CV score ranges  :\", jumlah_cv_ranges)\n",
      "\n",
      "    print(\"\\nPemeriksaan kelengkapan:\")\n",
      "\n",
      "    checks = {\n",
      "        \"25 outer experiments\":\n",
      "            jumlah_results == 25,\n",
      "\n",
      "        \"25 konfigurasi terbaik\":\n",
      "            jumlah_best_params == 25,\n",
      "\n",
      "        \"5.500 prediksi OOF\":\n",
      "            jumlah_oof == expected_oof,\n",
      "\n",
      "        \"500 baris permutation importance\":\n",
      "            jumlah_permutation == expected_permutation,\n",
      "\n",
      "        \"25 rentang inner CV\":\n",
      "            jumlah_cv_ranges == 25\n",
      "    }\n",
      "\n",
      "    for description, passed in checks.items():\n",
      "        print(\n",
      "            f\"{description}: \"\n",
      "            f\"{'BERHASIL' if passed else 'PERLU DIPERIKSA'}\"\n",
      "        )\n",
      "\n",
      "    # ==============================================\n",
      "\n",

      "# ============================================================\n",
      "\n",
      "from pathlib import Path\n",
      "import shutil\n",
      "import pandas as pd\n",
      "from IPython.display import display\n",
      "\n",
      "folder = Path(\"/Users/deffan/dataset\")\n",
      "folder_output = folder / \"hasil_akhir_notebook\"\n",
      "folder_output.mkdir(exist_ok=True)\n",
      "\n",
      "berkas_hasil = [\n",
      "    \"hasil_outer_experiment_pulihan.csv\",\n",
      "    \"best_hyperparameters_outer_fold_pulihan.csv\",\n",
      "    \"rekapitulasi_rata_rata_25_outer_fold.csv\",\n",

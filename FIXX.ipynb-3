    "    ),\n",
    "    \"Precision Macro\": (\n",
    "        \"baseline_precision_macro\",\n",
    "        \"optimized_precision_macro\"\n",
    "    ),\n",
    "    \"Recall Macro\": (\n",
    "        \"baseline_recall_macro\",\n",
    "        \"optimized_recall_macro\"\n",
    "    ),\n",
    "    \"F1 Macro\": (\n",
    "        \"baseline_f1_macro\",\n",
    "        \"optimized_f1_macro\"\n",
    "    )\n",
    "}\n",
    "\n",
    "for metric, (baseline_col, optimized_col) in metric_pairs.items():\n",
    "\n",
    "    baseline_mean = results_df[baseline_col].mean()\n",
    "    baseline_sd = results_df[baseline_col].std()\n",
    "\n",
    "    optimized_mean = results_df[optimized_col].mean()\n",
    "    optimized_sd = results_df[optimized_col].std()\n",
    "\n",
    "    difference = optimized_mean - baseline_mean\n",
    "\n",
    "    difference_percent = (\n",
    "        difference / baseline_mean\n",
    "    ) * 100\n",
    "\n",
    "    metrics_summary.append({\n",
    "        \"Metric\": metric,\n",
    "        \"Baseline Mean\": baseline_mean,\n",
    "        \"Baseline SD\": baseline_sd,\n",
    "        \"Optimized Mean\": optimized_mean,\n",
    "        \"Optimized SD\": optimized_sd,\n",
    "        \"Difference\": difference,\n",
    "        \"Difference (%)\": difference_percent\n",
    "    })\n",
    "\n",
    "summary_df = pd.DataFrame(metrics_summary)\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"PERFORMANCE SUMMARY\")\n",
    "print(\"=\" * 100)\n",
    "\n",
    "display(\n",
    "    summary_df\n",
    ")"
   ]
  },

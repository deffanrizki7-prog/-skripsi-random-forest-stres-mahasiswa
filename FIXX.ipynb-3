   "source": [
    "# ============================================================\n",
    "# VISUALISASI GAMBAR 2\n",
    "# Perbandingan Performa Random Forest Baseline dan Hasil Optimasi\n",
    "# ============================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Metrik evaluasi final\n",
    "metrics = [\n",
    "    \"Accuracy\",\n",
    "    \"Precision Macro\",\n",
    "    \"Recall Macro\",\n",
    "    \"F1 Macro\"\n",
    "]\n",
    "\n",
    "# Nilai final berdasarkan tabel hasil evaluasi\n",
    "baseline_values = [\n",
    "    87.6727,  # Accuracy\n",
    "    87.8401,  # Precision Macro\n",
    "    87.6586,  # Recall Macro\n",
    "    87.7094   # F1 Macro\n",
    "]\n",
    "\n",
    "optimized_values = [\n",
    "    87.6909,  # Accuracy\n",
    "    87.8444,  # Precision Macro\n",
    "    87.6787,  # Recall Macro\n",
    "    87.7237   # F1 Macro\n",
    "]\n",
    "\n",
    "# Posisi batang\n",
    "x = np.arange(len(metrics))\n",
    "width = 0.36\n",
    "\n",
    "# Membuat grafik\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "bars1 = ax.bar(\n",
    "    x - width / 2,\n",
    "    baseline_values,\n",
    "    width,\n",
    "    label=\"Baseline\"\n",
    ")\n",
    "\n",
    "bars2 = ax.bar(\n",
    "    x + width / 2,\n",
    "    optimized_values,\n",
    "    width,\n",
    "    label=\"Optimasi\"\n",
    ")\n",
    "\n",
    "# Judul grafik\n",
    "ax.set_title(\n",
    "    \"Perbandingan Performa Model Random Forest Baseline dan Hasil Optimasi\",\n",
    "    fontsize=13\n",
    ")\n",
    "\n",
    "# Label sumbu\n",
    "ax.set_ylabel(\"Nilai Performa (%)\")\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(metrics)\n",
    "\n",
    "# Legenda\n",
    "ax.legend()\n",
    "\n",
    "# Skala sumbu Y\n",
    "ax.set_ylim(87.4, 88.2)\n",
    "\n",
    "# Menampilkan nilai di atas setiap batang\n",
    "for bars in [bars1, bars2]:\n",
    "    for bar in bars:\n",
    "        height = bar.get_height()\n",
    "\n",
    "        ax.annotate(\n",
    "            f\"{height:.4f}%\",\n",
    "            xy=(bar.get_x() + bar.get_width() / 2, height),\n",
    "            xytext=(0, 4),\n",
    "            textcoords=\"offset points\",\n",
    "            ha=\"center\",\n",
    "            va=\"bottom\",\n",
    "            fontsize=8\n",
    "        )\n",
    "\n",
    "# Grid horizontal\n",
    "ax.grid(axis=\"y\", alpha=0.25)\n",
    "\n",
    "# Mengatur tata letak\n",
    "plt.tight_layout()\n",
    "\n",
    "# Menyimpan gambar\n",
    "plt.savefig(\n",
    "    \"Gambar_2_Perbandingan_Performa_Baseline_Optimasi.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "# Menampilkan grafik\n",
    "plt.show()"
   ]
  },

      "print(\"=\" * 100)\n",
      "print(\"BEST HYPERPARAMETER PADA 25 OUTER EXPERIMENT\")\n",
      "print(\"=\" * 100)\n",
      "\n",
      "display(best_params_df)\n",
      "\n",
      "--- CELL 14 ---\n",
      "# ============================================================\n",
      "# FREKUENSI BEST HYPERPARAMETER\n",
      "# ============================================================\n",
      "\n",
      "hyperparameters = [\n",
      "    \"n_estimators\",\n",
      "    \"max_depth\",\n",
      "    \"min_samples_split\",\n",
      "    \"min_samples_leaf\",\n",
      "    \"max_features\",\n",
      "    \"criterion\",\n",
      "    \"bootstrap\"\n",
      "]\n",
      "\n",
      "for parameter in hyperparameters:\n",
      "\n",
      "    print(\"\\n\" + \"=\" * 70)\n",
      "    print(f\"PARAMETER : {parameter}\")\n",
      "    print(\"=\" * 70)\n",
      "\n",
      "    frequency = (\n",
      "        best_params_df[parameter]\n",
      "        .value_counts()\n",
      "        .rename_axis(parameter)\n",
      "        .reset_index(name=\"frequency\")\n",
      "    )\n",
      "\n",
      "    frequency[\"percentage\"] = (\n",
      "        frequency[\"frequency\"] / len(best_params_df) * 100\n",
      "    )\n",
      "\n",
      "    display(frequency)\n",
      "\n",
      "--- CELL 20 ---\n",
      "# ============================================================\n",
      "# FINAL AUDIT - CLASSIFICATION REPORT\n",

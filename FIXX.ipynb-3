      "    if kolom in tabel.columns:\n",
      "        tabel[kolom] = tabel[kolom] * 100\n",
      "\n",
      "display(tabel.round(4))\n",
      "\n",
      "# Menghitung selisih berdasarkan nilai yang tersedia\n",
      "display(Markdown(\"## Interpretasi Hasil\"))\n",

      "    \"Total inner CV fits tidak sesuai.\"\n",
      "\n",
      "print(\"\\nVALIDASI KONFIGURASI: BERHASIL\")\n",
      "\n",
      "# ============================================================\n",
      "# 5. VALIDASI HASIL EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "print(\"\\n\" + \"=\" * 80)\n",
      "print(\"VALIDASI HASIL EKSPERIMEN\")\n",
      "print(\"=\" * 80)\n",
      "\n",

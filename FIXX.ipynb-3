      "\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score\n",
      ")\n",
      "\n",
      "def calculate_metrics(y_true, y_pred):\n",
      "\n",
      "    return {\n",
      "        \"accuracy\": accuracy_score(\n",
      "            y_true,\n",
      "            y_pred\n",
      "        ),\n",
      "\n",
      "        \"precision_macro\": precision_score(\n",
      "            y_true,\n",
      "            y_pred,\n",
      "            average=\"macro\",\n",
      "            zero_division=0\n",
      "        ),\n",
      "\n",
      "        \"recall_macro\": recall_score(\n",
      "            y_true,\n",
      "            y_pred,\n",
      "            average=\"macro\",\n",
      "            zero_division=0\n",
      "        ),\n",
      "\n",
      "        \"f1_macro\": f1_score(\n",
      "            y_true,\n",
      "            y_pred,\n",
      "            average=\"macro\",\n",
      "            zero_division=0\n",
      "        )\n",
      "    }\n",
      "\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"FUNGSI METRIK BERHASIL DIBUAT\")\n",
      "print(\"=\" * 70)\n",
      "\n",

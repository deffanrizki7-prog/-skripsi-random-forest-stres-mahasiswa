  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "31b0a62c-f0b1-4bfd-991c-63b37104c710",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "======================================================================\n",
      "CELL 12\n",
      "======================================================================\n",
      "import pandas as pd\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score\n",
      ")\n",
      "\n",
      "# Gunakan DataFrame OOF lengkap yang sudah tersedia.\n",
      "# Sesuaikan nama variabel oof_df jika berbeda.\n",
      "required_columns = [\n",
      "    \"seed\", \"fold\", \"index\",\n",
      "    \"y_true\", \"baseline_pred\", \"optimized_pred\"\n",
      "]\n",
      "\n",
      "assert all(col in oof_df.columns for col in required_columns), (\n",
      "    \"Periksa kembali nama kolom pada DataFrame OOF.\"\n",
      ")\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"VERIFIKASI DATA OOF\")\n",
      "print(\"=\" * 70)\n",
      "print(\"Jumlah baris       :\", len(oof_df))\n",
      "print(\"Jumlah random seed :\", oof_df[\"seed\"].nunique())\n",
      "print(\"Jumlah fold        :\", oof_df[\"fold\"].nunique())\n",
      "print(\"Jumlah target kosong:\", oof_df[\"y_true\"].isna().sum())\n",
      "\n",
      "assert len(oof_df) == 5500, \"Jumlah baris OOF tidak sesuai.\"\n",
      "assert oof_df[\"y_true\"].notna().all(), \"Ada target yang kosong.\"\n",
      "assert oof_df[\"baseline_pred\"].notna().all(), \"Prediksi baseline kosong.\"\n",
      "assert oof_df[\"optimized_pred\"].notna().all(), \"Prediksi optimized kosong.\"\n",
      "\n",
      "def calculate_metrics(y_true, y_pred):\n",
      "    return {\n",
      "        \"Accuracy (%)\": accuracy_score(y_true, y_pred) * 100,\n",
      "        \"Precision Macro (%)\": precision_score(\n",
      "            y_true, y_pred, average=\"macro\", zero_division=0\n",
      "        ) * 100,\n",
      "        \"Recall Macro (%)\": recall_score(\n",
      "            y_true, y_pred, average=\"macro\", zero_division=0\n",
      "        ) * 100,\n",
      "        \"F1-Score Macro (%)\": f1_score(\n",
      "            y_true, y_pred, average=\"macro\", zero_division=0\n",
      "        ) * 100,\n",
      "        \"Prediksi benar\": (y_true == y_pred).sum()\n",
      "    }\n",
      "\n",
      "results = pd.DataFrame({\n",
      "    \"Baseline\": calculate_metrics(\n",
      "        oof_df[\"y_true\"], oof_df[\"baseline_pred\"]\n",
      "    ),\n",
      "    \"Optimized\": calculate_metrics(\n",
      "        oof_df[\"y_true\"], oof_df[\"optimized_pred\"]\n",
      "    )\n",
      "})\n",
      "\n",
      "results[\"Selisih (Optimized - Baseline)\"] = (\n",
      "    results[\"Optimized\"] - results[\"Baseline\"]\n",
      ")\n",
      "\n",
      "print(\"\\nHASIL METRIK OOF AGREGAT\")\n",
      "display(results.round(4))\n",
      "\n",
      "print(\"\\nAKURASI PER MODEL\")\n",
      "for model in [\"baseline_pred\", \"optimized_pred\"]:\n",
      "    correct = (oof_df[\"y_true\"] == oof_df[model]).sum()\n",
      "    accuracy = correct / len(oof_df) * 100\n",
      "    print(f\"{model}: {correct}/5500 = {accuracy:.4f}%\")\n",
      "\n",
      "======================================================================\n",
      "CELL 15\n",
      "======================================================================\n",
      "ip = get_ipython()\n",
      "\n",
      "keywords = [\n",
      "    \"OOF PREDICTIONS\",\n",
      "    \"baseline_pred\",\n",
      "    \"optimized_pred\",\n",
      "    \"oof_predictions\",\n",
      "    \"oof_rows\",\n",
      "    \"mcnemar_df\"\n",
      "]\n",
      "\n",
      "history = ip.history_manager.input_hist_raw\n",
      "\n",
      "for cell_no, code in enumerate(history):\n",
      "    if any(keyword.lower() in code.lower() for keyword in keywords):\n",
      "        print(f\"\\n{'=' * 70}\")\n",
      "        print(f\"CELL {cell_no}\")\n",
      "        print(\"=\" * 70)\n",
      "        print(code[:5000])\n"
     ]
    }
   ],

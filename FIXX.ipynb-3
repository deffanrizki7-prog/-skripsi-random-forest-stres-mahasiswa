       "\n",
       "   baseline_wrong_optimized_correct  both_wrong  statistic   p_value  \n",
       "0                                20         126   0.108108  0.742308  \n",
       "1                                15         116   0.000000  1.000000  \n",
       "2                                24         122   0.595238  0.440401  \n",
       "3                                16         111   0.029412  0.863832  \n",
       "4                                14         114   0.484848  0.486234  "

   ],
   "source": [
    "# ============================================================\n",
    "# NESTED STRATIFIED 5-FOLD CROSS VALIDATION\n",
    "# 5 RANDOM SEEDS\n",
    "# ============================================================\n",
    "\n",
    "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.inspection import permutation_importance\n",
    "import time\n",
    "\n",
    "# ============================================================\n",
    "# RESET STORAGE\n",
    "# ============================================================\n",
    "\n",
    "all_outer_results = []\n",
    "all_best_params = []\n",
    "all_oof_predictions = []\n",
    "all_permutation_results = []\n",
    "\n",
    "# ============================================================\n",
    "# LOOP RANDOM SEED\n",
    "# ============================================================\n",
    "\n",
    "for RANDOM_STATE in RANDOM_SEEDS:\n",
    "\n",
    "    print(\"\\n\")\n",
    "    print(\"#\" * 80)\n",
    "    print(f\"RANDOM SEED : {RANDOM_STATE}\")\n",
    "    print(\"#\" * 80)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # OUTER STRATIFIED 5-FOLD\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    outer_cv = StratifiedKFold(\n",
    "        n_splits=N_SPLITS_OUTER,\n",
    "        shuffle=True,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # LOOP OUTER FOLD\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    for fold, (train_idx, test_idx) in enumerate(\n",
    "        outer_cv.split(X, y),\n",
    "        start=1\n",
    "    ):\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 75)\n",
    "        print(\n",
    "            f\"SEED {RANDOM_STATE} | \"\n",
    "            f\"OUTER FOLD {fold}/{N_SPLITS_OUTER}\"\n",
    "        )\n",
    "        print(\"=\" * 75)\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # OUTER TRAINING & TESTING\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        X_train = X.iloc[train_idx].copy()\n",
    "        X_test = X.iloc[test_idx].copy()\n",
    "\n",
    "        y_train = y.iloc[train_idx].copy()\n",
    "        y_test = y.iloc[test_idx].copy()\n",
    "\n",
    "        print(f\"Training : {len(X_train)} data\")\n",
    "        print(f\"Testing  : {len(X_test)} data\")\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # SAMPLE DATA TRAINING & TESTING\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        print(\"\\nSample Training Data:\")\n",
    "        display(\n",
    "            pd.concat(\n",
    "                [\n",
    "                    X_train,\n",
    "                    y_train.rename(\"stress_level\")\n",
    "                ],\n",
    "                axis=1\n",
    "            ).head(5)\n",
    "        )\n",
    "\n",
    "        print(\"\\nSample Testing Data:\")\n",
    "        display(\n",
    "            pd.concat(\n",
    "                [\n",
    "                    X_test,\n",
    "                    y_test.rename(\"stress_level\")\n",
    "                ],\n",
    "                axis=1\n",
    "            ).head(5)\n",
    "        )\n",
    "\n",
    "        # ====================================================\n",
    "        # 1. BASELINE\n",
    "        # ====================================================\n",
    "\n",
    "        print(\"\\n[1/3] Melatih Random Forest Baseline...\")\n",
    "\n",
    "        start_baseline = time.perf_counter()\n",
    "\n",
    "        baseline_model = RandomForestClassifier(\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "\n",
    "        baseline_model.fit(\n",
    "            X_train,\n",
    "            y_train\n",
    "        )\n",
    "\n",
    "        baseline_pred = baseline_model.predict(\n",
    "            X_test\n",
    "        )\n",
    "\n",
    "        baseline_time = (\n",
    "            time.perf_counter() - start_baseline\n",
    "        )\n",
    "\n",
    "        baseline_metrics = calculate_metrics(\n",
    "            y_test,\n",
    "            baseline_pred\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Baseline Accuracy : \"\n",
    "            f\"{baseline_metrics['accuracy']:.4f}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Baseline Macro F1 : \"\n",
    "            f\"{baseline_metrics['f1_macro']:.4f}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Waktu Baseline    : \"\n",
    "            f\"{baseline_time:.2f} detik\"\n",
    "        )\n",
    "\n",
    "        # ====================================================\n",
    "        # 2. INNER STRATIFIED 5-FOLD + GRIDSEARCH\n",
    "        # ====================================================\n",
    "\n",
    "        print(\"\\n[2/3] Menjalankan GridSearchCV...\")\n",
    "\n",
    "        print(\n",
    "            f\"Search space : {jumlah_kombinasi} kombinasi\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Inner CV     : {N_SPLITS_INNER}-Fold\"\n",
    "        )\n",
    "\n",
    "        inner_cv = StratifiedKFold(\n",
    "            n_splits=N_SPLITS_INNER,\n",
    "            shuffle=True,\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "\n",
    "        rf = RandomForestClassifier(\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "\n",
    "        start_optimized = time.perf_counter()\n",
    "\n",
    "        grid_search = GridSearchCV(\n",
    "            estimator=rf,\n",
    "            param_grid=param_grid,\n",
    "            scoring=\"accuracy\",\n",
    "            cv=inner_cv,\n",
    "            n_jobs=-1,\n",
    "            refit=True\n",
    "        )\n",
    "\n",
    "        grid_search.fit(\n",
    "            X_train,\n",
    "            y_train\n",
    "        )\n",
    "\n",
    "        optimized_time = (\n",
    "            time.perf_counter() - start_optimized\n",
    "        )\n",
    "\n",
    "        print(\"GridSearchCV selesai.\")\n",
    "\n",
    "        print(\n",
    "            f\"Waktu GridSearch : \"\n",
    "            f\"{optimized_time:.2f} detik\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Best Inner CV Accuracy : \"\n",
    "            f\"{grid_search.best_score_:.4f}\"\n",
    "        )\n",
    "\n",
    "        print(\"Best Hyperparameters:\")\n",
    "        print(grid_search.best_params_)\n",
    "\n",
    "        # ====================================================\n",
    "        # 3. MODEL OPTIMIZED\n",
    "        # ====================================================\n",
    "\n",
    "        print(\"\\n[3/3] Mengevaluasi model optimized...\")\n",
    "\n",
    "        optimized_model = (\n",
    "            grid_search.best_estimator_\n",
    "        )\n",
    "\n",
    "        optimized_pred = (\n",
    "            optimized_model.predict(X_test)\n",
    "        )\n",
    "\n",
    "        optimized_metrics = calculate_metrics(\n",
    "            y_test,\n",
    "            optimized_pred\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Optimized Accuracy : \"\n",
    "            f\"{optimized_metrics['accuracy']:.4f}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Optimized Macro F1 : \"\n",
    "            f\"{optimized_metrics['f1_macro']:.4f}\"\n",
    "        )\n",
    "\n",
    "        # ====================================================\n",
    "        # 4. PERMUTATION IMPORTANCE\n",
    "        # ====================================================\n",
    "\n",
    "        print(\"\\nMenghitung permutation importance...\")\n",
    "\n",
    "        permutation_result = permutation_importance(\n",
    "            optimized_model,\n",
    "            X_test,\n",
    "            y_test,\n",
    "            scoring=\"accuracy\",\n",
    "            n_repeats=30,\n",
    "            random_state=RANDOM_STATE,\n",
    "            n_jobs=-1\n",
    "        )\n",
    "\n",
    "        for feature, importance_mean, importance_std in zip(\n",
    "            X.columns,\n",
    "            permutation_result.importances_mean,\n",
    "            permutation_result.importances_std\n",
    "        ):\n",
    "\n",
    "            all_permutation_results.append({\n",
    "\n",
    "                \"seed\": RANDOM_STATE,\n",
    "                \"fold\": fold,\n",
    "\n",
    "                \"feature\": feature,\n",
    "\n",
    "                \"importance_mean\":\n",
    "                    importance_mean,\n",
    "\n",
    "                \"importance_std\":\n",
    "                    importance_std\n",
    "            })\n",
    "\n",
    "        # ====================================================\n",
    "        # 5. SIMPAN HASIL OUTER FOLD\n",
    "        # ====================================================\n",
    "\n",
    "        all_outer_results.append({\n",
    "\n",
    "            \"seed\": RANDOM_STATE,\n",
    "            \"fold\": fold,\n",
    "\n",
    "            \"n_train\": len(X_train),\n",
    "            \"n_test\": len(X_test),\n",
    "\n",
    "            \"baseline_accuracy\":\n",
    "                baseline_metrics[\"accuracy\"],\n",
    "\n",
    "            \"baseline_precision_macro\":\n",
    "                baseline_metrics[\"precision_macro\"],\n",
    "\n",
    "            \"baseline_recall_macro\":\n",
    "                baseline_metrics[\"recall_macro\"],\n",
    "\n",
    "            \"baseline_f1_macro\":\n",
    "                baseline_metrics[\"f1_macro\"],\n",
    "\n",
    "            \"optimized_accuracy\":\n",
    "                optimized_metrics[\"accuracy\"],\n",
    "\n",
    "            \"optimized_precision_macro\":\n",
    "                optimized_metrics[\"precision_macro\"],\n",
    "\n",
    "            \"optimized_recall_macro\":\n",
    "                optimized_metrics[\"recall_macro\"],\n",
    "\n",
    "            \"optimized_f1_macro\":\n",
    "                optimized_metrics[\"f1_macro\"],\n",
    "\n",
    "            \"best_inner_cv_accuracy\":\n",
    "                grid_search.best_score_,\n",
    "\n",
    "            \"baseline_time_seconds\":\n",
    "                baseline_time,\n",
    "\n",
    "            \"optimized_time_seconds\":\n",
    "                optimized_time,\n",
    "\n",
    "            \"additional_time_seconds\":\n",
    "                optimized_time - baseline_time\n",
    "        })\n",
    "\n",
    "        # ====================================================\n",
    "        # 6. SIMPAN HYPERPARAMETER\n",
    "        # ====================================================\n",
    "\n",
    "        best_params = (\n",
    "            grid_search.best_params_.copy()\n",
    "        )\n",
    "\n",
    "        best_params[\"seed\"] = RANDOM_STATE\n",
    "        best_params[\"fold\"] = fold\n",
    "\n",
    "        all_best_params.append(\n",
    "            best_params\n",
    "        )\n",
    "\n",
    "        # ====================================================\n",
    "        # 7. SIMPAN OOF PREDICTIONS\n",
    "        # ====================================================\n",
    "\n",
    "        for i in range(len(y_test)):\n",
    "\n",
    "            all_oof_predictions.append({\n",
    "\n",
    "                \"seed\": RANDOM_STATE,\n",
    "                \"fold\": fold,\n",
    "\n",
    "                \"index\":\n",
    "                    int(test_idx[i]),\n",
    "\n",
    "                \"y_true\":\n",
    "                    y_test.iloc[i],\n",
    "\n",
    "                \"baseline_pred\":\n",
    "                    baseline_pred[i],\n",
    "\n",
    "                \"optimized_pred\":\n",
    "                    optimized_pred[i]\n",
    "            })\n",
    "\n",
    "        print(\n",
    "            f\"\\nSeed {RANDOM_STATE}, \"\n",
    "            f\"Fold {fold} selesai.\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# SELESAI\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"#\" * 80)\n",
    "print(\"SELURUH NESTED CROSS-VALIDATION SELESAI\")\n",
    "print(\"#\" * 80)\n",
    "\n",
    "print(\n",
    "    \"Jumlah outer experiment :\",\n",
    "    len(all_outer_results)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Jumlah OOF prediction   :\",\n",
    "    len(all_oof_predictions)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Jumlah permutation rows :\",\n",
    "    len(all_permutation_results)\n",
    ")\n",
    "\n",
    "print(\"#\" * 80)"
   ]
  },

      "--- CELL 4 ---\n",
      "# ============================================================\n",
      "# KONFIGURASI EKSPERIMEN FINAL\n",
      "# ============================================================\n",
      "\n",
      "import time\n",
      "import sys\n",
      "import sklearn\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "from sklearn.inspection import permutation_importance\n",
      "\n",
      "# Daftar random seed\n",
      "RANDOM_SEEDS = [1, 7, 24, 42, 99]\n",
      "\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "# Ruang pencarian hyperparameter\n",
      "param_grid = {\n",
      "    'n_estimators': [100, 200, 300, 500],\n",
      "    'max_depth': [10, 20, 30, None],\n",
      "    'min_samples_split': [2, 5, 10],\n",
      "    'min_samples_leaf': [1, 2, 4],\n",
      "    'max_features': ['sqrt', 'log2', 0.3, 0.5, None],\n",
      "    'criterion': ['gini', 'entropy'],\n",
      "    'bootstrap': [True, False]\n",
      "}\n",
      "\n",
      "# Menghitung jumlah kombinasi hyperparameter\n",
      "jumlah_kombinasi = int(\n",
      "    np.prod([len(v) for v in param_grid.values()])\n",
      ")\n",
      "\n",
      "# Menghitung jumlah eksperimen dan fitting CV\n",
      "total_outer_experiments = (\n",
      "    len(RANDOM_SEEDS) * N_SPLITS_OUTER\n",
      ")\n",
      "\n",
      "fit_per_outer_fold = (\n",
      "    jumlah_kombinasi * N_SPLITS_INNER\n",
      ")\n",
      "\n",
      "total_cv_fits = (\n",
      "    fit_per_outer_fold * total_outer_experiments\n",
      ")\n",
      "\n",
      "# Menampilkan konfigurasi eksperimen\n",
      "print(\"=\" * 72)\n",
      "print(\"KONFIGURASI EKSPERIMEN FINAL\")\n",
      "print(\"=\" * 72)\n",
      "print(\"Random seeds :\", RANDOM_SEEDS)\n",
      "print(\"Outer CV     :\", N_SPLITS_OUTER, \"fold\")\n",
      "print(\"Inner CV     :\", N_SPLITS_INNER, \"fold\")\n",
      "print(\"Grid         :\", param_grid)\n",
      "print(\"Jumlah kombinasi hyperparameter :\", jumlah_kombinasi)\n",
      "print(\"Fit CV per outer fold :\", fit_per_outer_fold)\n",
      "print(\"Total outer experiments :\", total_outer_experiments)\n",
      "print(\"Total CV fits nested (tanpa refit) :\", total_cv_fits)\n",
      "print(\"Python      :\", sys.version)\n",
      "print(\"Pandas      :\", pd.__version__)\n",
      "print(\"NumPy       :\", np.__version__)\n",
      "print(\"Scikit-learn:\", sklearn.__version__)\n",
      "\n",

   ],
   "source": [
    "# ============================================================\n",
    "# FINAL AUDIT - MCNEMAR TEST PER RANDOM SEED\n",
    "# ============================================================\n",
    "\n",
    "from statsmodels.stats.contingency_tables import mcnemar\n",
    "\n",
    "mcnemar_results = []\n",
    "\n",
    "for seed in sorted(oof_final[\"seed\"].unique()):\n",
    "\n",
    "    data_seed = oof_final[\n",
    "        oof_final[\"seed\"] == seed\n",
    "    ].copy()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # STATUS BENAR / SALAH\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    baseline_correct = (\n",
    "        data_seed[\"baseline_pred\"]\n",
    "        == data_seed[\"y_true\"]\n",
    "    )\n",
    "\n",
    "    optimized_correct = (\n",
    "        data_seed[\"optimized_pred\"]\n",
    "        == data_seed[\"y_true\"]\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # MEMBENTUK TABEL KONTINGENSI MCNEMAR\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    both_correct = (\n",
    "        baseline_correct\n",
    "        & optimized_correct\n",
    "    ).sum()\n",
    "\n",
    "    baseline_correct_optimized_wrong = (\n",
    "        baseline_correct\n",
    "        & ~optimized_correct\n",
    "    ).sum()\n",
    "\n",
    "    baseline_wrong_optimized_correct = (\n",
    "        ~baseline_correct\n",
    "        & optimized_correct\n",
    "    ).sum()\n",
    "\n",
    "    both_wrong = (\n",
    "        ~baseline_correct\n",
    "        & ~optimized_correct\n",
    "    ).sum()\n",
    "\n",
    "    contingency_table = np.array([\n",
    "        [\n",
    "            both_correct,\n",
    "            baseline_correct_optimized_wrong\n",
    "        ],\n",
    "        [\n",
    "            baseline_wrong_optimized_correct,\n",
    "            both_wrong\n",
    "        ]\n",
    "    ])\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # MCNEMAR TEST\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    result = mcnemar(\n",
    "        contingency_table,\n",
    "        exact=False,\n",
    "        correction=True\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # SIMPAN HASIL\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    mcnemar_results.append({\n",
    "\n",
    "        \"seed\": seed,\n",
    "\n",
    "        \"both_correct\":\n",
    "            both_correct,\n",
    "\n",
    "        \"baseline_correct_optimized_wrong\":\n",
    "            baseline_correct_optimized_wrong,\n",
    "\n",
    "        \"baseline_wrong_optimized_correct\":\n",
    "            baseline_wrong_optimized_correct,\n",
    "\n",
    "        \"both_wrong\":\n",
    "            both_wrong,\n",
    "\n",
    "        \"statistic\":\n",
    "            result.statistic,\n",
    "\n",
    "        \"p_value\":\n",
    "            result.pvalue\n",
    "    })\n",
    "\n",
    "\n",
    "mcnemar_df = pd.DataFrame(\n",
    "    mcnemar_results\n",
    ")\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"HASIL MCNEMAR TEST PER RANDOM SEED\")\n",
    "print(\"=\" * 100)\n",
    "\n",
    "display(\n",
    "    mcnemar_df\n",
    ")"
   ]
  },

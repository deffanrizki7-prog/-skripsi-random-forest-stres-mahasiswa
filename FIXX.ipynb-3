      "Cell 125 | Tipe: code\n",
      "# ============================================================\n",
      "# REKAPITULASI HYPERPARAMETER YANG BERHASIL DIPULIHKAN\n",
      "# ============================================================\n",
      "\n",
      "import pandas as pd\n",
      "from pathlib import Path\n",
      "from IPython.display import display, Markdown\n",
      "\n",
      "folder = Path(\"/Users/deffan/dataset/hasil_akhir_notebook\")\n",
      "file_hp = folder / \"best_hyperparameters_outer_fold_pulihan.csv\"\n",
      "\n",
      "hp = pd.read_csv(file_hp)\n",
      "\n",
      "display(Markdown(\"## Konfigurasi Hyperparameter yang Dipulihkan\"))\n",
      "\n",
      "print(\"Jumlah konfigurasi yang tersedia:\", len(hp))\n",
      "display(hp)\n",
      "\n",
      "# Hitung frekuensi nilai setiap hyperparameter\n",
      "parameter = [\n",
      "    \"n_estimators\",\n",
      "    \"criterion\",\n",
      "    \"max_depth\",\n",
      "    \"max_features\",\n",
      "    \"min_samples_split\",\n",
      "    \"min_samples_leaf\",\n",
      "    \"bootstrap\"\n",
      "]\n",
      "\n",
      "hasil_frekuensi = []\n",
      "\n",
      "for kolom in parameter:\n",
      "    if kolom not in hp.columns:\n",
      "        continue\n",
      "\n",
      "    frekuensi = hp[kolom].fillna(\"None\").astype(str).value_counts()\n",
      "\n",
      "    for nilai, jumlah in frekuensi.items():\n",
      "        hasil_frekuensi.append({\n",
      "            \"Hyperparameter\": kolom,\n",
      "            \"Nilai\": nilai,\n",
      "            \"Frekuensi\": int(jumlah),\n",
      "            \"Persentase (%)\": round(jumlah / len(hp) * 100, 2)\n",
      "        })\n",
      "\n",
      "tabel_frekuensi = pd.DataFrame(hasil_frekuensi)\n",
      "\n",
      "display(Markdown(\"## Frekuensi Nilai Hyperparameter\"))\n",
      "display(tabel_frekuensi)\n",
      "\n",
      "print(\n",
      "    \"\\nCatatan: tabel ini hanya menggambarkan lima konfigurasi \"\n",
      "    \"yang berhasil dipulihkan. Tabel ini bukan rekapitulasi \"\n",
      "    \"lengkap dari seluruh 25 outer fold.\"\n",
      ")\n",
      "\n",
      "# Simpan hasil rekapitulasi\n",
      "output = folder / \"frekuensi_hyperparameter_pulihan.csv\"\n",
      "tabel_frekuensi.to_csv(output, index=False)\n",
      "\n",
      "print(\"\\nTabel frekuensi disimpan di:\", output)\n",
      "\n",
      "Output tersimpan:\n",
      "<IPython.core.display.Markdown object>\n",
      "\n",
      "Output tersimpan:\n",
      "Jumlah konfigurasi yang tersedia: 5\n",
      "\n",
      "\n",
      "Output tersimpan:\n",

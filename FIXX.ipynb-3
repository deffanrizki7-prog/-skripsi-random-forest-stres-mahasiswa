   "source": [
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "files_to_check = [\n",
    "    \"hasil_outer_experiment_pulihan.csv\",\n",
    "    \"hasil_outer_fold.csv\",\n",
    "    \"nested_cv_fold_results.csv\",\n",
    "    \"hasil_eksperimen_random_forest.csv\",\n",
    "    \"hasil_perbandingan_model.csv\"\n",
    "]\n",
    "\n",
    "for file in files_to_check:\n",
    "    print(\"\\n\" + \"=\" * 70)\n",
    "    print(\"FILE:\", file)\n",
    "    print(\"=\" * 70)\n",
    "\n",
    "    if os.path.exists(file):\n",
    "        data = pd.read_csv(file)\n",
    "\n",
    "        print(\"Ukuran data:\", data.shape)\n",
    "        print(\"Kolom:\", data.columns.tolist())\n",
    "\n",
    "        # Cari kolom yang berkaitan dengan seed, fold, dan hyperparameter\n",
    "        relevant_cols = [\n",
    "            col for col in data.columns\n",
    "            if any(key in col.lower() for key in [\n",
    "                \"seed\", \"fold\", \"bootstrap\", \"criterion\",\n",
    "                \"max_depth\", \"max_features\", \"min_samples\",\n",
    "                \"n_estimators\"\n",
    "            ])\n",
    "        ]\n",
    "\n",
    "        if relevant_cols:\n",
    "            display(data[relevant_cols].head(10))\n",
    "        else:\n",
    "            print(\"Tidak ditemukan kolom yang relevan.\")\n",
    "    else:\n",
    "        print(\"File tidak ditemukan.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "2e53f54d-42ab-487d-8c63-e67ab257ec8e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "================================================================================\n",
      "NOTEBOOK: FIXX-2_notebook_final_backup_20261016_220726.ipynb\n",
      "================================================================================\n",
      "\n",
      "Cell 3 | Tipe: code\n",
      "# ============================================================\n",
      "# KONFIGURASI EKSPERIMEN FINAL\n",
      "# ============================================================\n",
      "\n",
      "import time\n",
      "import sys\n",
      "import sklearn\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "from sklearn.inspection import permutation_importance\n",
      "\n",
      "# Daftar random seed\n",
      "RANDOM_SEEDS = [1, 7, 24, 42, 99]\n",
      "\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "# Ruang pencarian hyperparameter\n",
      "param_grid = {\n",
      "    'n_estimators': [100, 200, 300, 500],\n",
      "    'max_depth': [10, 20, 30, None],\n",
      "    'min_samples_split': [2, 5, 10],\n",
      "    'min_samples_leaf': [1, 2, 4],\n",
      "    'max_features': ['sqrt', 'log2', 0.3, 0.5, None],\n",
      "    'criterion': ['gini', 'entropy'],\n",
      "    'bootstrap': [True, False]\n",
      "}\n",
      "\n",
      "# Menghitung jumlah kombinasi hyperparameter\n",
      "jumlah_kombinasi = int(\n",
      "    np.prod([len(v) for v in param_grid.values()])\n",
      ")\n",
      "\n",
      "# Menghitung jumlah eksperimen dan fitting CV\n",
      "total_outer_experiments = (\n",
      "    len(RANDOM_SEEDS) * N_SPLITS_OUTER\n",
      ")\n",
      "\n",
      "fit_per_outer_fold = (\n",
      "    jumlah_kombinasi * N_SPLITS_INNER\n",
      ")\n",
      "\n",
      "total_cv_fits = (\n",
      "    fit_per_outer_fold * total_outer_experiments\n",
      ")\n",
      "\n",
      "# Menampilkan konfigurasi eksperimen\n",
      "print(\"=\" * 72)\n",
      "print(\"KONFIGURASI EKSPERIMEN FINAL\")\n",
      "print(\"=\" * 72)\n",
      "print(\"Random seeds :\", RANDOM_SEEDS)\n",
      "print(\"Outer CV     :\", N_SPLITS_OUTER, \"fold\")\n",
      "print(\"Inner CV     :\", N_SPLITS_INNER, \"fold\")\n",
      "print(\"Grid         :\", param_grid)\n",
      "print(\"Jumlah kombinasi hyperparameter :\", jumlah_kombinasi)\n",
      "print(\"Fit CV per outer fold :\", fit_per_outer_fold)\n",
      "print(\"Total outer experiments :\", total_outer_experiments)\n",
      "print(\"Total CV fits nested (tanpa refit) :\", total_cv_fits)\n",
      "print(\"Python      :\", sys.version)\n",
      "print(\"Pandas      :\", pd.__version__)\n",
      "print(\"NumPy       :\", np.__version__)\n",
      "print(\"Scikit-learn:\", sklearn.__version__)\n",
      "\n",
      "\n",
      "Output tersimpan:\n",
      "========================================================================\n",
      "KONFIGURASI EKSPERIMEN FINAL\n",
      "========================================================================\n",
      "Random seeds : [1, 7, 24, 42, 99]\n",
      "Outer CV     : 5 fold\n",
      "Inner CV     : 5 fold\n",
      "Grid         : {'n_estimators': [100, 200, 300, 500], 'max_depth': [10, 20, 30, None], 'min_samples_split': [2, 5, 10], 'min_samples_leaf': [1, 2, 4], 'max_features': ['sqrt', 'log2', 0.3, 0.5, None], 'criterion': ['gini', 'entropy'], 'bootstrap': [True, False]}\n",
      "Jumlah kombinasi hyperparameter : 2880\n",
      "Fit CV per outer fold : 14400\n",
      "Total outer experiments : 25\n",
      "Total CV fits nested (tanpa refit) : 360000\n",
      "Python      : 3.14.6 (v3.14.6:c63aec69bd5, Jun 10 2026, 08:07:54) [Clang 21.0.0 (clang-2100.1.1.101)]\n",
      "Pandas      : 3.0.3\n",
      "NumPy       : 2.4.6\n",
      "Scikit-learn: 1.9.0\n",
      "\n",
      "\n",
      "Cell 8 | Tipe: code\n",
      "## ============================================================\n",
      "# PERSIAPAN PARAMETER NESTED STRATIFIED 5-FOLD CV\n",
      "# ============================================================\n",
      "\n",

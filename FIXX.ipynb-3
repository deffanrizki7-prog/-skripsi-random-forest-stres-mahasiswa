      "Cell 51 | Tipe: code\n",
      "# ============================================================\n",
      "# VALIDASI FINAL NESTED STRATIFIED 5-FOLD CROSS-VALIDATION\n",
      "# RANDOM FOREST HYPERPARAMETER OPTIMIZATION\n",
      "# ============================================================\n",
      "\n",
      "import numpy as np\n",
      "import pandas as pd\n",
      "\n",
      "# ============================================================\n",
      "# 1. KONFIGURASI EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "RANDOM_SEEDS = [1, 7, 24, 42, 99]\n",
      "\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200, 300, 500],\n",
      "    \"max_depth\": [10, 20, 30, None],\n",
      "    \"min_samples_split\": [2, 5, 10],\n",
      "    \"min_samples_leaf\": [1, 2, 4],\n",
      "    \"max_features\": [\"sqrt\", \"log2\", 0.3, 0.5, None],\n",
      "    \"criterion\": [\"gini\", \"entropy\"],\n",
      "    \"bootstrap\": [True, False]\n",
      "}\n",
      "\n",
      "# ============================================================\n",
      "# 2. MENGHITUNG KOMBINASI DAN FITTING\n",
      "# ============================================================\n",
      "\n",
      "jumlah_kombinasi = int(\n",
      "    np.prod([\n",
      "        len(values)\n",
      "        for values in param_grid.values()\n",
      "    ])\n",
      ")\n",
      "\n",
      "jumlah_outer_experiments = (\n",
      "    len(RANDOM_SEEDS) * N_SPLITS_OUTER\n",
      ")\n",
      "\n",
      "jumlah_fits_per_outer = (\n",
      "    jumlah_kombinasi * N_SPLITS_INNER\n",
      ")\n",
      "\n",
      "jumlah_total_fits = (\n",
      "    jumlah_fits_per_outer * jumlah_outer_experiments\n",
      ")\n",
      "\n",
      "# ============================================================\n",
      "# 3. MENAMPILKAN KONFIGURASI\n",
      "# ============================================================\n",
      "\n",
      "print(\"=\" * 80)\n",
      "print(\"VALIDASI FINAL KONFIGURASI EKSPERIMEN\")\n",
      "print(\"=\" * 80)\n",
      "\n",
      "print(\"Random seeds                  :\", RANDOM_SEEDS)\n",
      "print(\"Jumlah random seeds           :\", len(RANDOM_SEEDS))\n",
      "print(\"Outer cross-validation        :\", N_SPLITS_OUTER, \"fold\")\n",
      "print(\"Inner cross-validation        :\", N_SPLITS_INNER, \"fold\")\n",
      "print(\"Jumlah kombinasi hyperparameter:\", jumlah_kombinasi)\n",
      "print(\"Fitting per outer fold        :\", jumlah_fits_per_outer)\n",
      "print(\"Jumlah outer experiments      :\", jumlah_outer_experiments)\n",
      "print(\"Total inner CV fits           :\", jumlah_total_fits)\n",
      "\n",
      "print(\"\\nRuang pencarian hyperparameter:\")\n",
      "for parameter, values in param_grid.items():\n",
      "    print(f\"{parameter}: {values}\")\n",
      "\n",
      "print(\"=\" * 80)\n",
      "\n",
      "# ============================================================\n",
      "# 4. VALIDASI KONFIGURASI\n",
      "# ============================================================\n",
      "\n",
      "assert len(RANDOM_SEEDS) == 5, \\\n",
      "    \"Jumlah random seed tidak sesuai.\"\n",
      "\n",
      "assert N_SPLITS_OUTER == 5, \\\n",
      "    \"Jumlah outer fold tidak sesuai.\"\n",
      "\n",
      "assert N_SPLITS_INNER == 5, \\\n",
      "    \"Jumlah inner \n",
      "... [kode dipotong]\n",

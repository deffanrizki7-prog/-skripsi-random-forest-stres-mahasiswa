      "# ============================================================\n",
      "# RINGKASAN AKHIR EKSPERIMEN\n",
      "# Random Forest Baseline vs Optimasi\n",
      "# ============================================================\n",
      "\n",
      "import pandas as pd\n",
      "from IPython.display import display, Markdown\n",
      "from pathlib import Path\n",
      "\n",
      "folder_hasil = Path(\n",
      "    \"/Users/deffan/dataset/hasil_akhir_notebook\"\n",
      ")\n",
      "\n",
      "file_rekap = folder_hasil / \"rekapitulasi_performa_25_outer_fold.csv\"\n",
      "\n",
      "# Membaca hasil eksperimen yang sudah tersedia\n",
      "hasil = pd.read_csv(file_rekap)\n",
      "\n",
      "# Menampilkan ringkasan performa\n",
      "display(Markdown(\"## Ringkasan Performa Model\"))\n",
      "\n",
      "tabel = hasil.copy()\n",
      "\n",
      "# Mengubah metrik menjadi persen untuk memudahkan pembacaan\n",
      "kolom_metrik = [\"Baseline\", \"Optimasi\"]\n",
      "\n",
      "for kolom in kolom_metrik:\n",
      "    if kolom in tabel.columns:\n",
      "        tabel[kolom] = tabel[kolom] * 100\n",
      "\n",
      "display(tabel.round(4))\n",
      "\n",
      "# Menghitung selisih berdasarkan nilai yang tersedia\n",
      "display(Markdown(\"## Interpretasi Hasil\"))\n",
      "\n",
      "if \"Selisih (poin persentase)\" in hasil.columns:\n",
      "    selisih = hasil[\"Selisih (poin persentase)\"]\n",
      "\n",
      "    jumlah_meningkat = int((selisih > 0).sum())\n",
      "    jumlah_menurun = int((selisih < 0).sum())\n",
      "    jumlah_sama = int((selisih == 0).sum())\n",
      "\n",
      "    print(f\"Metrik yang meningkat : {jumlah_meningkat}\")\n",
      "    print(f\"Metrik yang menurun   : {jumlah_menurun}\")\n",
      "    print(f\"Metrik yang sama      : {jumlah_sama}\")\n",
      "\n",
      "    print(\n",
      "        \"\\nInterpretasi: hasil optimasi dibandingkan dengan \"\n",
      "        \"model baseline berdasarkan rata-rata performa \"\n",
      "        \"25 eksperimen outer fold.\"\n",
      "    )\n",
      "else:\n",
      "    print(\n",
      "        \"Kolom selisih tidak ditemukan. \"\n",
      "        \"Silakan gunakan tabel rekapitulasi yang sudah tersedia.\"\n",
      "    )\n",
      "\n",
      "print(\"\\nCatatan:\")\n",
      "print(\n",
      "    \"Ringkasan ini menggunakan hasil eksperimen yang sudah \"\n",
      "    \"tersimpan dan tidak menjalankan ulang pelatihan model.\"\n",

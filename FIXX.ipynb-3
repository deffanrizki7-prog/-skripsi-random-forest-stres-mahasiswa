    "import json\n",
    "import os\n",
    "\n",
    "notebooks = [\n",
    "    \"FIXX-2_notebook_final_backup_20261016_220726.ipynb\",\n",
    "    \"FIXX-2_notebook_final.ipynb\"\n",
    "]\n",
    "\n",
    "kata_kunci = [\n",
    "    \"param_grid\",\n",
    "    \"GridSearchCV(\",\n",
    "    \"best_params_\",\n",
    "    \"performance_summary_final.csv\",\n",

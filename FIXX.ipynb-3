    "\n",
    "for nama, obj in globals().copy().items():\n",
    "    if isinstance(obj, pd.DataFrame):\n",
    "        print(f\"\\nNama variabel: {nama}\")\n",
    "        print(f\"Ukuran: {obj.shape}\")\n",
    "        print(f\"Kolom: {obj.columns.tolist()}\")"
   ]

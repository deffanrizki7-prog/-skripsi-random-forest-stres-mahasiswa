      "54:         )\n",
      "55:         print(\"=\" * 75)\n",
      "56: \n",
      "57:         # ----------------------------------------------------\n",
      "58:         # OUTER TRAINING & TESTING\n",
      "59:         # ----------------------------------------------------\n",
      "60: \n",
      "61:         X_train = X.iloc[train_idx].copy()\n",

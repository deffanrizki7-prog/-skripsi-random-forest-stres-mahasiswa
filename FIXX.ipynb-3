   "source": [
    "# ============================================================\n",
    "# FINAL COMPARISON TABLE\n",
    "# ============================================================\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score\n",
    ")\n",
    "\n",
    "comparison_final = pd.DataFrame({\n",
    "\n",
    "    \"Metric\": [\n",
    "        \"Accuracy\",\n",
    "        \"Precision Macro\",\n",
    "        \"Recall Macro\",\n",
    "        \"F1 Macro\"\n",
    "    ],\n",
    "\n",
    "    \"Baseline\": [\n",
    "        accuracy_score(\n",
    "            y_true,\n",
    "            baseline_pred\n",
    "        ),\n",
    "\n",
    "        precision_score(\n",
    "            y_true,\n",
    "            baseline_pred,\n",
    "            average=\"macro\"\n",
    "        ),\n",
    "\n",
    "        recall_score(\n",
    "            y_true,\n",
    "            baseline_pred,\n",
    "            average=\"macro\"\n",
    "        ),\n",
    "\n",
    "        f1_score(\n",
    "            y_true,\n",
    "            baseline_pred,\n",
    "            average=\"macro\"\n",
    "        )\n",
    "    ],\n",
    "\n",
    "    \"Optimized\": [\n",
    "        accuracy_score(\n",
    "            y_true,\n",
    "            optimized_pred\n",
    "        ),\n",
    "\n",
    "        precision_score(\n",
    "            y_true,\n",
    "            optimized_pred,\n",
    "            average=\"macro\"\n",
    "        ),\n",
    "\n",
    "        recall_score(\n",
    "            y_true,\n",
    "            optimized_pred,\n",
    "            average=\"macro\"\n",
    "        ),\n",
    "\n",
    "        f1_score(\n",
    "            y_true,\n",
    "            optimized_pred,\n",
    "            average=\"macro\"\n",
    "        )\n",
    "    ]\n",
    "})\n",
    "\n",
    "comparison_final[\"Difference\"] = (\n",
    "    comparison_final[\"Optimized\"]\n",
    "    - comparison_final[\"Baseline\"]\n",
    ")\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"PERBANDINGAN FINAL MODEL\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "display(comparison_final)"
   ]
  },

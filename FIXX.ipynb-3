   "source": [
    "# Pastikan kolom target tersedia\n",
    "TARGET = \"stress_level\"\n",
    "\n",
    "if TARGET not in df.columns:\n",
    "    raise ValueError(\n",
    "        f\"Kolom '{TARGET}' tidak ditemukan. \"\n",
    "        f\"Kolom yang tersedia: {df.columns.tolist()}\"\n",
    "    )\n",
    "\n",
    "# Ambil kolom numerik\n",
    "numeric_df = df.select_dtypes(include=[np.number])\n",
    "\n",
    "# Hitung matriks korelasi Pearson\n",
    "correlation_matrix = numeric_df.corr(method=\"pearson\")\n",
    "\n",
    "# Pisahkan fitur dan target\n",
    "feature_columns = [\n",
    "    col for col in numeric_df.columns if col != TARGET\n",
    "]\n",
    "\n",
    "feature_corr = correlation_matrix.loc[\n",
    "    feature_columns, feature_columns\n",
    "]\n",
    "\n",
    "# Ambil hanya pasangan unik, tanpa diagonal\n",
    "upper_triangle = feature_corr.where(\n",
    "    np.triu(np.ones(feature_corr.shape), k=1).astype(bool)\n",
    ")\n",
    "\n",
    "# Susun pasangan fitur berdasarkan korelasi absolut\n",
    "feature_pairs = (\n",
    "    upper_triangle.stack()\n",
    "    .rename(\"correlation\")\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "feature_pairs.columns = [\"feature_1\", \"feature_2\", \"correlation\"]\n",
    "feature_pairs[\"absolute_correlation\"] = (\n",
    "    feature_pairs[\"correlation\"].abs()\n",
    ")\n",
    "\n",
    "feature_pairs = feature_pairs.sort_values(\n",
    "    \"absolute_correlation\", ascending=False\n",
    ")\n",
    "\n",
    "print(\"10 PASANGAN FITUR DENGAN KORELASI TERTINGGI\")\n",
    "display(feature_pairs.head(10).round(4))\n",
    "\n",
    "# Korelasi setiap fitur terhadap target\n",
    "target_corr = (\n",
    "    correlation_matrix[TARGET]\n",
    "    .drop(TARGET)\n",
    "    .rename(\"correlation_with_stress_level\")\n",
    "    .to_frame()\n",
    ")\n",
    "\n",
    "target_corr[\"absolute_correlation\"] = (\n",
    "    target_corr[\"correlation_with_stress_level\"].abs()\n",
    ")\n",
    "\n",
    "target_corr = target_corr.sort_values(\n",
    "    \"absolute_correlation\", ascending=False\n",
    ")\n",
    "\n",
    "print(\"\\nKORELASI SETIAP FITUR TERHADAP STRESS_LEVEL\")\n",
    "display(target_corr.round(4))\n",
    "\n",
    "# Pasangan dengan korelasi tinggi: |r| >= 0.60\n",
    "threshold = 0.60\n",
    "\n",
    "high_corr_pairs = feature_pairs[\n",
    "    feature_pairs[\"absolute_correlation\"] >= threshold\n",
    "]\n",
    "\n",
    "print(f\"\\nPASANGAN FITUR DENGAN |r| >= {threshold}\")\n",
    "if high_corr_pairs.empty:\n",
    "    print(\"Tidak ditemukan pasangan fitur yang memenuhi ambang tersebut.\")\n",
    "else:\n",
    "    display(high_corr_pairs.round(4))"
   ]
  },

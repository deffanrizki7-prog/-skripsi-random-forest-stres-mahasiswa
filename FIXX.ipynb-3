    "import json\n",
    "import os\n",
    "\n",
    "notebooks = [\n",
    "    \"FIXX-2_notebook_final_backup_20261016_220726.ipynb\",\n",
    "    \"FIXX-2_notebook_final.ipynb\",\n",
    "    \"FIXX-2_revisi_kode_awal.ipynb\",\n",
    "    \"FIXX.ipynb\",\n",
    "    \"setelah semhas.ipynb\",\n",
    "    \"sebelum semhas.ipynb\"\n",
    "]\n",
    "\n",
    "kata_kunci = [\n",
    "    \"param_grid\",\n",
    "    \"GridSearchCV\",\n",
    "    \"best_params_\",\n",
    "    \"performance_summary_final\",\n",
    "    \"rekapitulasi_performa_25_outer_fold\",\n",
    "    \"final_performance_nested_cv\",\n",
    "    \"out_of_fold_predictions\",\n",
    "    \"cross_val_score\",\n",
    "    \"StratifiedKFold\",\n",
    "    \"classification_report\"\n",
    "]\n",
    "\n",
    "for nama_file in notebooks:\n",
    "    if not os.path.exists(nama_file):\n",
    "        continue\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 90)\n",
    "    print(\"NOTEBOOK:\", nama_file)\n",
    "    print(\"=\" * 90)\n",
    "\n",
    "    with open(nama_file, \"r\", encoding=\"utf-8\") as f:\n",
    "        notebook = json.load(f)\n",
    "\n",
    "    for nomor, cell in enumerate(notebook.get(\"cells\", []), start=1):\n",
    "        if cell.get(\"cell_type\") != \"code\":\n",
    "            continue\n",
    "\n",
    "        kode = \"\".join(cell.get(\"source\", []))\n",
    "\n",
    "        if any(k.lower() in kode.lower() for k in kata_kunci):\n",
    "            print(f\"\\n--- CELL {nomor} ---\")\n",
    "            print(kode[:5000])"
   ]
  },

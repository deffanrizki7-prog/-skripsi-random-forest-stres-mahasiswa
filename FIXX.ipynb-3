    "import json\n",
    "import re\n",
    "\n",
    "file = \"FIXX.ipynb\"\n",
    "\n",
    "with open(file, \"r\", encoding=\"utf-8\") as f:\n",
    "    notebook = json.load(f)\n",
    "\n",
    "for i in [12, 24, 25]:\n",
    "    cell = notebook[\"cells\"][i]\n",
    "\n",
    "    print(f\"\\n{'=' * 50}\")\n",
    "    print(f\"CELL {i}\")\n",
    "    print(f\"{'=' * 50}\")\n",
    "\n",
    "    found = False\n",
    "\n",
    "    for output in cell.get(\"outputs\", []):\n",
    "        data = output.get(\"data\", {})\n",
    "\n",
    "        # Ambil output teks biasa jika tersedia\n",
    "        text_output = \"\".join(data.get(\"text/plain\", []))\n",
    "\n",
    "        if text_output:\n",
    "            if (\n",
    "                \"bootstrap\" in text_output.lower()\n",
    "                and \"max_features\" in text_output.lower()\n",
    "            ):\n",
    "                print(text_output[:5000])\n",
    "                found = True\n",
    "\n",
    "        # Jika output berupa HTML, ambil teks tabel secara sederhana\n",
    "        html_output = \"\".join(data.get(\"text/html\", []))\n",
    "\n",
    "        if html_output and not found:\n",
    "            rows = re.findall(\n",
    "                r\"<tr[^>]*>(.*?)</tr>\",\n",
    "                html_output,\n",
    "                flags=re.I | re.S\n",
    "            )\n",
    "\n",
    "            relevant_rows = []\n",
    "\n",
    "            for row in rows:\n",
    "                cells = re.findall(\n",
    "                    r\"<t[hd][^>]*>(.*?)</t[hd]>\",\n",
    "                    row,\n",
    "                    flags=re.I | re.S\n",
    "                )\n",
    "\n",
    "                clean_cells = [\n",
    "                    re.sub(r\"<[^>]+>\", \"\", c).strip()\n",
    "                    for c in cells\n",
    "                ]\n",
    "\n",
    "                line = \" | \".join(clean_cells)\n",
    "\n",
    "                if line:\n",
    "                    relevant_rows.append(line)\n",
    "\n",
    "            if relevant_rows:\n",
    "                print(\"\\n\".join(relevant_rows[:30]))\n",
    "                found = True\n",
    "\n",
    "    if not found:\n",
    "        print(\"Output tabel hyperparameter tidak ditemukan pada cell ini.\")"
   ]
  },

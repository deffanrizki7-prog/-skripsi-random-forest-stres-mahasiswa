      "--- CELL 10 ---\n",
      "# ============================================================\n",
      "# NESTED STRATIFIED 5-FOLD CROSS-VALIDATION\n",
      "# 5 RANDOM SEEDS\n",
      "# REVISI FINAL SESUAI ARAHAN DOSEN\n",
      "# ============================================================\n",
      "\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.inspection import permutation_importance\n",
      "\n",
      "import time\n",
      "import numpy as np\n",
      "import pandas as pd\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 1. KONFIGURASI EKSPERIMEN FINAL\n",
      "# ============================================================\n",
      "\n",
      "RANDOM_SEEDS = [1, 7, 24, 42, 99]\n",
      "\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "# Ruang pencarian hyperparameter\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200, 300, 500],\n",
      "    \"max_depth\": [10, 20, 30, None],\n",
      "    \"min_samples_split\": [2, 5, 10],\n",
      "    \"min_samples_leaf\": [1, 2, 4],\n",
      "    \"max_features\": [\"sqrt\", \"log2\", 0.3, 0.5, None],\n",
      "    \"criterion\": [\"gini\", \"entropy\"],\n",
      "    \"bootstrap\": [True, False]\n",
      "}\n",
      "\n",
      "# Menghitung jumlah kombinasi hyperparameter\n",
      "jumlah_kombinasi = int(\n",
      "    np.prod([len(values) for values in param_grid.values()])\n",
      ")\n",
      "\n",
      "# Menghitung jumlah eksperimen\n",
      "total_outer_experiments = (\n",
      "    len(RANDOM_SEEDS) * N_SPLITS_OUTER\n",
      ")\n",
      "\n",
      "# Menghitung jumlah fitting validasi silang\n",
      "fit_per_outer_fold = (\n",
      "    jumlah_kombinasi * N_SPLITS_INNER\n",
      ")\n",
      "\n",
      "total_cv_fits = (\n",
      "    fit_per_outer_fold * total_outer_experiments\n",
      ")\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 2. MENAMPILKAN KONFIGURASI EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "print(\"=\" * 80)\n",
      "print(\"KONFIGURASI EKSPERIMEN FINAL\")\n",
      "print(\"=\" * 80)\n",
      "\n",
      "print(\"Random Seeds :\", RANDOM_SEEDS)\n",
      "print(\"Outer CV     :\", N_SPLITS_OUTER, \"fold\")\n",
      "print(\"Inner CV     :\", N_SPLITS_INNER, \"fold\")\n",
      "print(\"Grid         :\", param_grid)\n",
      "\n",
      "print(\"Jumlah kombinasi hyperparameter :\", jumlah_kombinasi)\n",
      "print(\"Fit CV per outer fold :\", fit_per_outer_fold)\n",
      "print(\"Total outer experiments :\", total_outer_experiments)\n",
      "print(\"Total CV fits nested (tanpa refit) :\", total_cv_fits)\n",
      "\n",
      "print(\"=\" * 80)\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 3. RESET PENYIMPANAN HASIL\n",
      "# ============================================================\n",
      "\n",
      "all_outer_results = []\n",
      "all_best_params = []\n",
      "all_oof_predictions = []\n",
      "all_permutation_results = []\n",
      "all_cv_score_ranges = []\n",
      "\n",
      "start_experiment = time.perf_counter()\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 4. LOOP RANDOM SEED\n",
      "# ============================================================\n",
      "\n",
      "for RANDOM_STATE in RANDOM_SEEDS:\n",
      "\n",
      "    print(\"\\n\")\n",
      "    print(\"#\" * 80)\n",
      "    print(f\"RANDOM SEED : {RANDOM_STATE}\")\n",
      "    print(\"#\" * 80)\n",
      "\n",
      "    # --------------------------------------------------------\n",
      "    # OUTER STRATIFIED 5-FOLD\n",
      "    # --------------------------------------------------------\n",
      "\n",
      "    outer_cv = StratifiedKFold(\n",
      "        n_splits=N_SPLITS_OUTER,\n",
      "        shuffle=True,\n",
      "        random_state=RANDOM_STATE\n",
      "    )\n",
      "\n",
      "    # --------------------------------------------------------\n",
      "    # LOOP OUTER FOLD\n",
      "    # --------------------------------------------------------\n",
      "\n",
      "    for fold, (train_idx, test_idx) in enumerate(\n",
      "        outer_cv.split(X, y),\n",
      "        start=1\n",
      "    ):\n",
      "\n",
      "        print(\"\\n\" + \"=\" * 75)\n",
      "        print(\n",
      "            f\"SEED {RANDOM_STATE} | \"\n",
      "            f\"OUTER FOLD {fold}/{N_SPLITS_OUTER}\"\n",
      "        )\n",
      "        print(\"=\" * 75)\n",
      "\n",
      "        # ====================================================\n",
      "        # 4.1. MEMBAGI DATA OUTER TRAINING DAN TESTING\n",
      "        # ====================================================\n",
      "\n",
      "        X_train = X.iloc[train_idx].copy()\n",
      "        X_test = X.iloc[test_idx].copy()\n",
      "\n",
      "        y_train = y.iloc[train_idx].copy()\n",
      "        y_test = y.iloc[test_idx].copy()\n",
      "\n",
      "        print(f\"Training : {len(X_train)} data\")\n",
      "        print(f\"Testing  : {len(X_test)} data\")\n",
      "\n",
      "        # ====================================================\n",
      "        # 4.2. RANDOM FOREST BASELINE\n",
      "        # ====================================================\n",
      "\n",
      "        print(\"\\n[1/4] Melatih Random Forest Baseline...\")\n",
      "\n",
      "        start_baseline = time.perf_counter()\n",
      "\n",
      "        baseline_model = RandomForestClassifier(\n",
      "            random_state=RANDOM_STATE\n",
      "        )\n",
      "\n",
      "        baseline_model.fit(\n",
      "            X_train,\n",
      "            y_train\n",
      "        )\n",
      "\n",
      "        baseline_pred = baseline_model.predict(\n",
      "            X_test\n",
      "        )\n",
      "\n",
      "        baseline_time = (\n",
      "            time.perf_counter() - start_baseline\n",
      "        )\n",
      "\n",
      "        baseline_metrics = calculate_metrics(\n",
      "            y_test,\n",
      "            baseline_pred\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Baseline Accuracy : \"\n",
      "            f\"{baseline_metrics['accuracy']:.6f}\"\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Baseline Macro F1 : \"\n",
      "            f\"{baseline_metrics['f1_macro']:.6f}\"\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Waktu Baseline    : \"\n",
      "            f\"{baseline_time:.2f} detik\"\n",
      "        )\n",
      "\n",
      "        # ====================================================\n",
      "        # 4.3. INNER STRATIFIED CV DAN GRIDSEAR\n",
      "\n",

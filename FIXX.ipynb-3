      "--- CELL 56 ---\n",
      "import os\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score\n",
      ")\n",
      "\n",
      "# ============================================================\n",
      "# 1. BACA FILE PREDIKSI OOF YANG SUDAH TERSIMPAN\n",
      "# ============================================================\n",
      "\n",
      "file_oof = \"out_of_fold_predictions.csv\"\n",
      "\n",
      "if not os.path.exists(file_oof):\n",
      "    raise FileNotFoundError(\n",
      "        f\"File {file_oof} tidak ditemukan di direktori kerja.\"\n",
      "    )\n",
      "\n",
      "oof_df = pd.read_csv(file_oof)\n",
      "\n",
      "print(\"=\" * 75)\n",
      "print(\"PEMERIKSAAN FILE PREDIKSI OOF\")\n",
      "print(\"=\" * 75)\n",
      "print(\"Nama file       :\", file_oof)\n",
      "print(\"Jumlah baris    :\", len(oof_df))\n",
      "print(\"Nama kolom      :\", oof_df.columns.tolist())\n",
      "\n",
      "display(oof_df.head())\n",
      "\n",
      "# ============================================================\n",
      "# 2. PERIKSA KELENGKAPAN KOLOM\n",
      "# ============================================================\n",
      "\n",
      "required_columns = [\n",
      "    \"seed\",\n",
      "    \"fold\",\n",
      "    \"index\",\n",
      "    \"y_true\",\n",
      "    \"baseline_pred\",\n",
      "    \"optimized_pred\"\n",
      "]\n",
      "\n",
      "if all(col in oof_df.columns for col in required_columns):\n",
      "\n",
      "    print(\"\\nStruktur kolom sesuai dengan format prediksi OOF.\")\n",
      "\n",
      "    print(\"Jumlah seed :\", oof_df[\"seed\"].nunique())\n",
      "    print(\"Jumlah fold :\", oof_df[\"fold\"].nunique())\n",
      "\n",
      "    # ========================================================\n",
      "    # 3. HITUNG ULANG METRIK DARI PREDIKSI YANG TERSIMPAN\n",
      "    # ========================================================\n",
      "\n",
      "    def hitung_metrik(y_true, y_pred):\n",
      "        return {\n",
      "            \"Jumlah prediksi benar\": int(\n",
      "                np.sum(np.asarray(y_true) == np.asarray(y_pred))\n",
      "            ),\n",
      "            \"Accuracy (%)\": accuracy_score(y_true, y_pred) * 100,\n",
      "            \"Precision Macro (%)\": precision_score(\n",
      "                y_true, y_pred,\n",
      "                average=\"macro\",\n",
      "                zero_division=0\n",
      "            ) * 100,\n",
      "            \"Recall Macro (%)\": recall_score(\n",
      "                y_true, y_pred,\n",
      "                average=\"macro\",\n",
      "                zero_division=0\n",
      "            ) * 100,\n",
      "            \"F1-Score Macro (%)\": f1_score(\n",
      "                y_true, y_pred,\n",
      "                average=\"macro\",\n",
      "                zero_division=0\n",
      "            ) * 100\n",
      "        }\n",
      "\n",
      "    baseline = hitung_metrik(\n",
      "        oof_df[\"y_true\"],\n",
      "        oof_df[\"baseline_pred\"]\n",
      "    )\n",
      "\n",
      "    optimized = hitung_metrik(\n",
      "        oof_df[\"y_true\"],\n",
      "        oof_df[\"optimized_pred\"]\n",
      "    )\n",
      "\n",
      "    hasil = pd.DataFrame({\n",
      "        \"Baseline\": baseline,\n",
      "        \"Optimized\": optimized\n",
      "    })\n",
      "\n",
      "    hasil[\"Selisih\"] = (\n",
      "        hasil[\"Optimized\"] - hasil[\"Baseline\"]\n",
      "    )\n",
      "\n",
      "    print(\"\\n\" + \"=\" * 75)\n",
      "    print(\"HASIL PERHITUNGAN ULANG METRIK OOF\")\n",
      "    print(\"=\" * 75)\n",
      "\n",
      "    display(hasil.round(6))\n",
      "\n",
      "    # ========================================================\n",
      "    # 4. BANDINGKAN DENGAN ANGKA DALAM SKRIPSI\n",
      "    # ========================================================\n",
      "\n",
      "    print(\"\\nPEMERIKSAAN ACCURACY TERHADAP DUA VERSI SKRIPSI\")\n",
      "\n",
      "    print(\n",
      "        \"Accuracy baseline aktual : \"\n",
      "        f\"{baseline['Accuracy (%)']:.6f}%\"\n",
      "    )\n",
      "\n",
      "    print(\n",
      "        \"Accuracy optimized aktual: \"\n",
      "        f\"{optimized['Accuracy (%)']:.6f}%\"\n",
      "    )\n",
      "\n",
      "    print(\n",
      "        \"Versi A di skripsi        : baseline 87.6727%, \"\n",
      "        \"optimized 87.5273%\"\n",
      "    )\n",
      "\n",
      "    print(\n",
      "        \"Versi B di skripsi        : baseline 87.6727%, \"\n",
      "        \"optimized 87.6909%\"\n",
      "    )\n",
      "\n",
      "else:\n",
      "    print(\n",
      "        \"\\nKolom file berbeda dari format yang diharapkan.\"\n",
      "        \"\\nPeriksa nama kolom di atas sebelum menghitung metrik.\"\n",
      "    )\n",
      "\n",
      "==========================================================================================\n",
      "NOTEBOOK: setelah semhas.ipynb\n",
      "==========================================================================================\n",
      "\n",
      "--- CELL 1 ---\n",
      "# ============================================================\n",
      "# EKSPERIMEN RANDOM FOREST:\n",
      "# BASELINE vs OPTIMASI GRIDSEARCHCV\n",
      "# 5 RANDOM SEED\n",
      "# ============================================================\n",
      "\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "import matplotlib.pyplot as plt\n",
      "import seaborn as sns\n",
      "\n",
      "from sklearn.model_selection import (\n",
      "    train_test_split,\n",
      "    StratifiedKFold,\n",
      "    GridSearchCV\n",
      ")\n",
      "\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score,\n",
      "    confusion_matrix,\n",
      "    classification_report\n",
      ")\n",
      "\n",
      "from statsmodels.stats.contingency_tables import mcnemar\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 1. DATASET\n",
      "# ============================================================\n",
      "\n",
      "df = pd.read_csv(\"StressLevelDataset.csv\")\n",
      "\n",
      "target = \"stress_level\"\n",
      "\n",
      "X = df.drop(columns=[target])\n",
      "y = df[target]\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"INFORMASI DATASET\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "print(\"Jumlah data   :\", X.shape[0])\n",
      "print(\"Jumlah fitur  :\", X.shape[1])\n",
      "print(\"Target        :\", target)\n",
      "\n",
      "print(\"\\nDistribusi kelas:\")\n",
      "print(y.value_counts().sort_index())\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 2. RANDOM SEED\n",
      "# ============================================================\n",
      "\n",
      "random_seeds = [42, 1, 7, 24, 99]\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 3. GRID HYPERPARAMETER\n",
      "# ============================================================\n",
      "\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200, 300, 500],\n",
      "    \"max_depth\": [10, 20, 30, None],\n",
      "    \"min_samples_split\": [2, 5, 10],\n",
      "    \"min_samples_leaf\": [1, 2, 4],\n",
      "    \"max_features\": [\"sqrt\", \"log2\"],\n",
      "    \"criterion\": [\"gini\", \"entropy\"],\n",
      "    \"bootstrap\": [True, False]\n",
      "}\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 4. VERIFIKASI JUMLAH KOMBINASI\n",
      "# ============================================================\n",
      "\n",
      "jumlah_kombinasi = np.prod([\n",
      "    len(nilai)\n",
      "    for nilai in param_grid.values()\n",
      "])\n",
      "\n",
      "jumlah_fit_per_seed = jumlah_kombinasi * 5\n",
      "jumlah_total_fit = jumlah_fit_per_seed * len(random_seeds)\n",
      "\n",
      "print(\"\\n\" + \"=\" * 70)\n",
      "print(\"GRID HYPERPARAMETER\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "print(\"Jumlah kombinasi hyperparameter :\", jumlah_kombinasi)\n",
      "print(\"Jumlah fold CV                  : 5\")\n",
      "print(\"Training per random seed       :\", jumlah_fit_per_seed)\n",
      "print(\"Jumlah random seed             :\", len(random_seeds))\n",
      "print(\"Total proses training          :\", jumlah_total_fit)\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 5. PENYIMPANAN HASIL\n",
      "# ============================================================\n",
      "\n",
      "results = []\n",
      "\n",
      "classification_reports = {}\n",
      "\n",
      "confusion_matrices = {}\n",
      "\n",
      "feature_importance_results = {}\n",
      "\n",
      "mcnemar_results = {}\n",
      "\n",
      "best_models = {}\n",
      "\n",
      "best_parameters = {}\n",
      "\n",
      "\n",
      "# ============================================================\n",
      "# 6. PERULANGAN EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "for seed in random_seeds:\n",
      "\n",
      "    print(\"\\n\")\n",
      "    print(\"=\" * 70)\n",
      "    print(f\"RANDOM SEED = {seed}\")\n",
      "    print(\"=\" * 70)\n",
      "\n",
      "\n",
      "    # ========================================================\n",
      "    # A. TRAIN-TEST SPLIT\n",
      "    # ========================================================\n",
      "\n",
      "    X_train, X_test, y_train, y_test = train_test_split(\n",
      "        X,\n",
      "        y,\n",
      "        test_size=0.20,\n",
      "        train_size=0.80,\n",
      "        stratify=y,\n",
      "        random_state=seed\n",
      "    )\n",
      "\n",
      "    print(\"\\nData training :\", len(X_train))\n",
      "    print(\"Data testing  :\", len(X_test))\n",
      "\n",
      "\n",
      "    # ========================================================\n",
      "    # B. MODEL BASELINE\n",
      "    # ========================================================\n",
      "\n",
      "    baseline_model = RandomForestClassifier(\n",
      "        random_state=seed\n",
      "    )\n",
      "\n",
      "    baseline_model.fit(\n",
      "        X_train,\n",
      "        y_train\n",
      "    )\n",
      "\n",
      "    baseline_pred = baseline_model.predict(\n",
      "        X_test\n",
      "    )\n",
      "\n",
      "\n",
      "    # ========================================================\n",
      "    # C. EVALUASI BASELINE\n",
      "    # ========================================================\n",
      "\n",
      "    baseline_accuracy = accuracy_score(\n",
      "        y_test,\n",
      "        baseline_pred\n",
      "    )\n",
      "\n",
      "    baseline_precision = precision_score(\n",
      "        y_test,\n",
      "        baseline_pred,\n",
      "        average=\"weighted\",\n",
      "        zero_division=0\n",
      "    )\n",
      "\n",
      "    baseline_recall = recall_score(\n",
      "        y_test,\n",
      "        baseline_pred,\n",
      "        average=\"weighted\",\n",
      "        zero_division=0\n",
      "    )\n",
      "\n",
      "    baseline_f1 = f1_score(\n",
      "        y_test,\n",
      "        baseline_pred,\n",
      "        average=\"weighted\",\n",
      "        zero_division=0\n",
      "    )\n",
      "\n",
      "    baseline_cm = confusion_matrix(\n",
      "        y_test,\n",
      "        baseline_pred\n",
      "    )\n",
      "\n",
      "\n",
      "    # ========================================================\n",
      "    # D. STRATIFIED K-FOLD CROSS VALIDATION\n",
      "    # ========================================================\n",
      "\n",
      "    cv = StratifiedKFold(\n",
      "        n_splits=5,\n",
      "        shuffle=True,\n",
      "        random_state=seed\n",
      "    )\n",
      "\n",
      "\n",
      "    # ========================================================\n",
      "    # E. GRIDSEARCHCV\n",
      "    # ========================================================\n",
      "\n",
      "    grid_\n",
      "\n",
      "==========================================================================================\n",
      "NOTEBOOK: sebelum semhas.ipynb\n",
      "==========================================================================================\n",
      "\n",
      "--- CELL 1 ---\n",
      "# ==========================================================\n",
      "# IMPORT LIBRARY\n",
      "# Optimasi Hyperparameter Random Forest\n",
      "# ==========================================================\n",
      "\n",
      "# Manipulasi Data\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "\n",
      "# Visualisasi\n",
      "import matplotlib.pyplot as plt\n",
      "import seaborn as sns\n",
      "\n",
      "# Machine Learning\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "\n",
      "# Model Selection\n",
      "from sklearn.model_selection import (\n",
      "    train_test_split,\n",
      "    StratifiedKFold,\n",
      "    GridSearchCV,\n",
      "    RandomizedSearchCV\n",
      ")\n",
      "\n",
      "# Evaluasi\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score,\n",
      "    confusion_matrix,\n",
      "    classification_report\n",
      ")\n",
      "\n",
      "# Statistik\n",
      "from scipy.stats import randint\n",
      "\n",
      "# Setting Tampilan\n",
      "pd.set_option(\"display.max_columns\", None)\n",
      "pd.set_option(\"display.width\", 1000)\n",
      "\n",
      "sns.set_style(\"whitegrid\")\n",
      "\n",
      "print(\"=\"*60)\n",
      "print(\"IMPORT LIBRARY BERHASIL\")\n",
      "print(\"=\"*60)\n",
      "\n",
      "--- CELL 16 ---\n",
      "# ==========================================================\n",
      "# CLASSIFICATION REPORT BASELINE\n",
      "# ==========================================================\n",
      "\n",
      "print(\"=\"*60)\n",
      "print(\"CLASSIFICATION REPORT BASELINE\")\n",
      "print(\"=\"*60)\n",
      "\n",
      "print(\n",
      "\n",
      "    classification_report(\n",
      "\n",
      "        y_test,\n",
      "\n",
      "        baseline_pred\n",
      "\n",
      "    )\n",
      "\n",
      ")\n",
      "\n",
      "--- CELL 17 ---\n",
      "# ==========================================================\n",
      "# STRATIFIED K-FOLD\n",
      "# ==========================================================\n",
      "\n",
      "cv = StratifiedKFold(\n",
      "\n",
      "    n_splits=5,\n",
      "\n",
      "    shuffle=True,\n",
      "\n",
      "    random_state=42\n",
      "\n",
      ")\n",
      "\n",
      "print(cv)\n",
      "\n",
      "--- CELL 18 ---\n",
      "# ==========================================================\n",
      "# GRID SEARCH CV (REFINEMENT)\n",
      "# ==========================================================\n",
      "\n",
      "param_grid = {\n",
      "\n",
      "    \"n_estimators\": [300, 400, 500, 600, 700],\n",
      "\n",
      "    \"max_depth\": [None, 20, 30, 40],\n",
      "\n",
      "    \"min_samples_split\": [2, 3, 4],\n",
      "\n",
      "    \"min_samples_leaf\": [1, 2],\n",
      "\n",
      "    \"criterion\": [\"gini\"],\n",
      "\n",
      "    \"max_features\": [\"sqrt\"],\n",
      "\n",
      "    \"bootstrap\": [True]\n",
      "\n",
      "}\n",
      "\n",
      "grid_search = GridSearchCV(\n",
      "\n",
      "    estimator=RandomForestClassifier(\n",
      "        random_state=42\n",
      "    ),\n",
      "\n",
      "    param_grid=param_grid,\n",
      "\n",
      "    cv=cv,\n",
      "\n",
      "    scoring=\"accuracy\",\n",
      "\n",
      "    n_jobs=-1,\n",
      "\n",
      "    verbose=2\n",
      "\n",
      ")\n",
      "\n",
      "grid_search.fit(\n",
      "    X_train,\n",
      "    y_train\n",
      ")\n",
      "\n",
      "--- CELL 19 ---\n",
      "print(\"=\"*60)\n",
      "print(\"BEST PARAMETER GRID SEARCH\")\n",
      "print(\"=\"*60)\n",
      "\n",
      "print(grid_search.best_params_)\n",
      "\n",
      "print()\n",
      "\n",
      "print(\"Best CV Score\")\n",
      "\n",
      "print(grid_search.best_score_)\n",
      "\n",
      "--- CELL 24 ---\n",
      "# ==========================================================\n",
      "# CLASSIFICATION REPORT MODEL OPTIMASI\n",
      "# ==========================================================\n",
      "\n",
      "print(classification_report(\n",
      "    y_test,\n",
      "    best_pred\n",
      "))\n",
      "\n",
      "--- CELL 29 ---\n",
      "# ==========================================================\n",
      "# PARAMETER TERBAIK\n",
      "# ==========================================================\n",
      "\n",
      "print(\"=\"*60)\n",
      "print(\"BEST PARAMETER\")\n",
      "print(\"=\"*60)\n",
      "\n",
      "print(grid_search.best_params_)\n"
     ]
    }
   ],

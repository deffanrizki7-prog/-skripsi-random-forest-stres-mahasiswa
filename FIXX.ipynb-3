    "import json\n",
    "import os\n",
    "\n",
    "file = \"FIXX.ipynb\"\n",
    "\n",
    "if not os.path.exists(file):\n",
    "    print(\"FIXX.ipynb tidak ditemukan di folder kerja.\")\n",
    "else:\n",
    "    with open(file, \"r\", encoding=\"utf-8\") as f:\n",
    "        nb = json.load(f)\n",
    "\n",
    "    kata_kunci = [\n",
    "        \"param_grid\",\n",
    "        \"GridSearchCV(\",\n",
    "        \"best_params_\",\n",
    "        \"StratifiedKFold\",\n",
    "        \"performance_summary_final\",\n",
    "        \"rekapitulasi_performa_25_outer_fold\",\n",
    "        \"out_of_fold_predictions\"\n",
    "    ]\n",
    "\n",
    "    for nomor, cell in enumerate(nb[\"cells\"], start=1):\n",
    "        if cell.get(\"cell_type\") != \"code\":\n",
    "            continue\n",
    "\n",
    "        kode = \"\".join(cell.get(\"source\", []))\n",
    "        baris_cocok = [\n",
    "            (i + 1, baris.strip()[:150])\n",
    "            for i, baris in enumerate(kode.splitlines())\n",
    "            if any(k.lower() in baris.lower() for k in kata_kunci)\n",
    "        ]\n",
    "\n",
    "        if baris_cocok:\n",
    "            print(f\"\\nCell {nomor}:\")\n",
    "            for nomor_baris, isi in baris_cocok[:8]:\n",
    "                print(f\"  Baris {nomor_baris}: {isi}\")"
   ]

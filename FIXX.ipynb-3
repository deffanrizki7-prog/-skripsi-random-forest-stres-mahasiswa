      "38:         random_state=RANDOM_STATE\n",
      "39:     )\n",
      "40: \n",
      "41:     # --------------------------------------------------------\n",
      "42:     # LOOP OUTER FOLD\n",
      "43:     # --------------------------------------------------------\n",
      "44: \n",
      "45:     for fold, (train_idx, test_idx) in enumerate(\n",
      "46:         outer_cv.split(X, y),\n",
      "47:         start=1\n",
      "48:     ):\n",
      "49: \n",
      "50:         print(\"\\n\" + \"=\" * 75)\n",
      "51:         print(\n",
      "52:             f\"SEED {RANDOM_STATE} | \"\n",

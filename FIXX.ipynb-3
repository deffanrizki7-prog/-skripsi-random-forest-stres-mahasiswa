      "Cell 70 | Tipe: code\n",
      "import json\n",
      "import re\n",
      "\n",
      "nama_file = \"FIXX-2_revisi_kode_awal.ipynb\"\n",
      "\n",
      "with open(nama_file, \"r\", encoding=\"utf-8\") as f:\n",
      "    notebook = json.load(f)\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"PEMERIKSAAN KONFIGURASI GRID DALAM NOTEBOOK\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "kata_kunci = [\n",
      "    \"param_grid\",\n",
      "    \"max_features\",\n",
      "    \"GridSearchCV\",\n",
      "    \"all_outer_results\"\n",
      "]\n",
      "\n",
      "for i, cell in enumerate(notebook[\"cells\"]):\n",
      "    if cell.get(\"cell_type\") != \"code\":\n",
      "        continue\n",
      "\n",
      "    kode = \"\".join(cell.get(\"source\", []))\n",
      "\n",
      "    if any(kunci in kode for kunci in kata_kunci):\n",
      "        print(f\"\\n{'=' * 25} CELL {i} {'=' * 25}\")\n",
      "\n",
      "        for nomor, baris in enumerate(kode.splitlines(), start=1):\n",
      "            if any(kunci in baris for kunci in kata_kunci):\n",
      "                awal = max(0, nomor - 3)\n",
      "                akhir = min(len(kode.splitlines()), nomor + 8)\n",
      "\n",
      "                for j in range(awal, akhir):\n",
      "                    print(f\"{j + 1:3}: {kode.splitlines()[j]}\")\n",
      "\n",
      "                print(\"-\" * 40)\n",
      "\n",
      "Output tersimpan:\n",
      "======================================================================\n",
      "PEMERIKSAAN KONFIGURASI GRID DALAM NOTEBOOK\n",
      "======================================================================\n",
      "\n",
      "========================= CELL 0 =========================\n",
      " 17: \n",
      " 18: from sklearn.ensemble import RandomForestClassifier\n",
      " 19: from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      " 20: from sklearn.metrics import (\n",
      " 21:     accuracy_score,\n",
      " 22:     precision_score,\n",
      " 23:     recall_score,\n",
      " 24:     f1_score,\n",
      " 25:     confusion_matrix,\n",
      " 26:     classification_report\n",
      " 27: )\n",
      "----------------------------------------\n",
      "\n",
      "========================= CELL 3 =========================\n",
      " 10: \n",
      " 11: from sklearn.ensemble import RandomForestClassifier\n",
      " 12: from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      " 13: from sklearn.inspection import permutation_importance\n",
      " 14: \n",
      " 15: # Daftar random seed\n",

   "source": [
    "# ============================================================\n",
    "# FREKUENSI KOMBINASI HYPERPARAMETER TERBAIK\n",
    "# ============================================================\n",
    "\n",
    "hyperparameter_columns = [\n",
    "    \"n_estimators\",\n",
    "    \"max_depth\",\n",
    "    \"min_samples_split\",\n",
    "    \"min_samples_leaf\",\n",
    "    \"max_features\",\n",
    "    \"criterion\",\n",
    "    \"bootstrap\"\n",
    "]\n",
    "\n",
    "combination_frequency = (\n",
    "    all_best_params_df[\n",
    "        hyperparameter_columns\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .value_counts()\n",
    "    .reset_index(\n",
    "        name=\"frequency\"\n",
    "    )\n",
    ")\n",
    "\n",
    "combination_frequency[\"percentage\"] = (\n",
    "    combination_frequency[\"frequency\"]\n",
    "    / len(all_best_params_df)\n",
    "    * 100\n",
    ")\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"FREKUENSI KOMBINASI HYPERPARAMETER TERBAIK\")\n",
    "print(\"=\" * 100)\n",
    "\n",
    "display(\n",
    "    combination_frequency\n",
    ")"
   ]
  },

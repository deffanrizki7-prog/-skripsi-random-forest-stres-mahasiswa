      "    \"grafik_perbandingan_baseline_vs_optimasi.png\",\n",
      "    \"grafik_selisih_performa_optimasi.png\",\n",
      "    \"grafik_accuracy_per_seed.png\"\n",
      "]\n",
      "\n",
      "status = []\n",
      "\n",
      "for nama in berkas_hasil:\n",
      "    sumber = folder / nama\n",
      "\n",
      "    if sumber.exists():\n",
      "        tujuan = folder_output / nama\n",
      "        shutil.copy2(sumber, tujuan)\n",
      "        status.append({\n",
      "            \"Berkas\": nama,\n",

      "    selisih = hasil[\"Selisih (poin persentase)\"]\n",
      "\n",
      "    jumlah_meningkat = int((selisih > 0).sum())\n",
      "    jumlah_menurun = int((selisih < 0).sum())\n",
      "    jumlah_sama = int((selisih == 0).sum())\n",
      "\n",
      "    print(f\"Metrik yang meningkat : {jumlah_meningkat}\")\n",
      "    print(f\"Metrik yang menurun   : {jumlah_menurun}\")\n",
      "    print(f\"Metrik yang sama      : {jumlah_sama}\")\n",
      "\n",
      "    print(\n",
      "        \"\\nInterpretasi: hasil optimasi dibandingkan dengan \"\n",
      "        \"model baseline berdasarkan rata-rata performa \"\n",
      "        \"25 eksperimen outer fold.\"\n",

    "import json\n",
    "import os\n",
    "\n",
    "notebooks = [\n",
    "    \"FIXX-2_notebook_final_backup_20261016_220726.ipynb\",\n",
    "    \"FIXX-2_notebook_final.ipynb\",\n",
    "    \"FIXX-2_revisi_kode_awal.ipynb\",\n",
    "    \"FIXX.ipynb\"\n",
    "]\n",
    "\n",
    "for filename in notebooks:\n",
    "    if not os.path.exists(filename):\n",
    "        continue\n",
    "\n",
    "    with open(filename, \"r\", encoding=\"utf-8\") as f:\n",
    "        notebook = json.load(f)\n",
    "\n",
    "    print(f\"\\n{filename}\")\n",
    "\n",
    "    for i, cell in enumerate(notebook.get(\"cells\", [])):\n",
    "        source = \"\".join(cell.get(\"source\", []))\n",
    "\n",
    "        # Cari cell yang menyimpan hasil hyperparameter\n",
    "        if (\n",
    "            \"all_best_params.append\" in source\n",
    "            or \"best_params_df.to_csv\" in source\n",
    "            or \"best_hyperparameters_outer_fold\" in source\n",
    "            or \"best_params_df = pd.DataFrame\" in source\n",
    "        ):\n",
    "            print(f\"  Cell {i}: ditemukan kode penyimpanan hyperparameter\")\n",
    "\n",
    "        # Cari output tabel yang kemungkinan memuat 25 hasil\n",
    "        for output in cell.get(\"outputs\", []):\n",
    "            data = output.get(\"data\", {})\n",
    "            text_output = \"\".join(data.get(\"text/plain\", []))\n",
    "\n",
    "            if (\n",
    "                \"max_features\" in text_output\n",
    "                and \"bootstrap\" in text_output\n",

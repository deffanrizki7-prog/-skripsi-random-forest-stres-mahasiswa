   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score\n",
    ")\n",
    "\n",
    "oof = pd.read_csv(\"out_of_fold_predictions.csv\")\n",
    "\n",
    "def hitung_metrik(y_true, y_pred):\n",
    "    return {\n",
    "        \"Prediksi benar\": int(\n",
    "            np.sum(np.asarray(y_true) == np.asarray(y_pred))\n",
    "        ),\n",
    "        \"Accuracy (%)\": accuracy_score(y_true, y_pred) * 100,\n",
    "        \"Precision Macro (%)\": precision_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ) * 100,\n",
    "        \"Recall Macro (%)\": recall_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ) * 100,\n",
    "        \"F1-Score Macro (%)\": f1_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ) * 100\n",
    "    }\n",
    "\n",
    "baseline = hitung_metrik(\n",
    "    oof[\"Actual\"],\n",
    "    oof[\"Baseline_Prediction\"]\n",
    ")\n",
    "\n",
    "optimized = hitung_metrik(\n",
    "    oof[\"Actual\"],\n",
    "    oof[\"Optimized_Prediction\"]\n",
    ")\n",
    "\n",
    "hasil = pd.DataFrame({\n",
    "    \"Baseline\": baseline,\n",
    "    \"Optimized\": optimized\n",
    "})\n",
    "\n",
    "hasil[\"Selisih\"] = hasil[\"Optimized\"] - hasil[\"Baseline\"]\n",
    "\n",
    "print(\"Jumlah baris:\", len(oof))\n",
    "print(\"\\nHASIL METRIK DARI FILE OOF\")\n",
    "display(hasil.round(4))"
   ]
  },

      "\n",
      "import pandas as pd\n",
      "from IPython.display import display\n",
      "\n",
      "path = \"/Users/deffan/dataset/hasil_outer_experiment_pulihan.csv\"\n",
      "df = pd.read_csv(path)\n",
      "\n",
      "metrik = {\n",
      "    \"Accuracy\": (\"baseline_accuracy\", \"optimized_accuracy\"),\n",
      "    \"Precision Macro\": (\n",
      "        \"baseline_precision_macro\",\n",
      "        \"optimized_precision_macro\"\n",
      "    ),\n",
      "    \"Recall Macro\": (\n",
      "        \"baseline_recall_macro\",\n",
      "        \"optimized_recall_macro\"\n",
      "    ),\n",
      "    \"F1-Score Macro\": (\"baseline_f1_macro\", \"optimized_f1_macro\")\n",
      "}\n",
      "\n",
      "rows = []\n",
      "\n",
      "for nama, (baseline_col, optimized_col) in metrik.items():\n",
      "    baseline = df[baseline_col].mean()\n",
      "    optimized = df[optimized_col].mean()\n",
      "\n",
      "    rows.append({\n",
      "        \"Metrik\": nama,\n",
      "        \"Baseline\": baseline,\n",
      "        \"Optimasi\": optimized,\n",
      "        \"Selisih (poin persentase)\": (optimized - baseline) * 100\n",
      "    })\n",
      "\n",
      "rekap_performa_df = pd.DataFrame(rows)\n",
      "\n",
      "print(\"REKAPITULASI PERFORMA 25 OUTER FOLD\")\n",
      "display(\n",
      "    rekap_performa_df.style.format({\n",
      "        \"Baseline\": \"{:.6f}\",\n",
      "        \"Optimasi\": \"{:.6f}\",\n",
      "        \"Selisih (poin persentase)\": \"{:+.4f}\"\n",
      "    })\n",
      ")\n",
      "\n",
      "output_path = (\n",
      "    \"/Users/deffan/dataset/\"\n",
      "    \"rekapitulasi_performa_25_outer_fold.csv\"\n",
      ")\n",
      "\n",
      "rekap_performa_df.to_csv(output_path, index=False)\n",
      "print(\"\\nTabel disimpan di:\", output_path)\n",
      "\n",

    "import json\n",
    "import os\n",
    "\n",
    "notebooks = [\n",
    "    \"FIXX-2_notebook_final_backup_20261016_220726.ipynb\",\n",
    "    \"FIXX-2_notebook_final.ipynb\",\n",
    "    \"FIXX-2_revisi_kode_awal.ipynb\",\n",
    "    \"FIXX.ipynb\"\n",
    "]\n",
    "\n",
    "keywords = [\n",
    "    \"all_best_params\",\n",
    "    \"best_params_df\",\n",
    "    \"best_hyperparameters_outer_fold\",\n",
    "    \"grid_search.best_params_\",\n",
    "    \"max_features\",\n",
    "    \"bootstrap\"\n",
    "]\n",
    "\n",
    "for filename in notebooks:\n",
    "    if not os.path.exists(filename):\n",
    "        continue\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"NOTEBOOK:\", filename)\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    with open(filename, \"r\", encoding=\"utf-8\") as f:\n",
    "        notebook = json.load(f)\n",
    "\n",
    "    for i, cell in enumerate(notebook.get(\"cells\", [])):\n",
    "        source = \"\".join(cell.get(\"source\", []))\n",
    "\n",
    "        # Periksa kode yang berkaitan dengan penyimpanan hyperparameter\n",
    "        if any(keyword in source for keyword in keywords):\n",
    "            print(f\"\\nCell {i} | Tipe: {cell.get('cell_type')}\")\n",
    "\n",
    "            if len(source) > 2500:\n",
    "                print(source[:2500])\n",
    "                print(\"... [kode dipotong]\")\n",
    "            else:\n",
    "                print(source)\n",
    "\n",
    "            # Periksa output yang sudah tersimpan\n",
    "            for output in cell.get(\"outputs\", []):\n",
    "                text_output = \"\"\n",
    "\n",
    "                if \"text\" in output:\n",
    "                    text_output = \"\".join(output[\"text\"])\n",
    "\n",
    "                data = output.get(\"data\", {})\n",
    "                if \"text/plain\" in data:\n",
    "                    text_output += \"\".join(data[\"text/plain\"])\n",
    "\n",
    "                if text_output.strip():\n",
    "                    print(\"\\nOutput tersimpan:\")\n",
    "                    print(text_output[:3000])"
   ]
  },

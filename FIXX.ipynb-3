      "\n",
      "[1/3] Melatih Random Forest Baseline...\n",
      "Baseline Accuracy : 0.8909\n",
      "Baseline Macro F1 : 0.8914\n",
      "Waktu Baseline    : 0.11 detik\n",
      "\n",
      "[2/3] Menjalankan GridSearchCV...\n",
      "Search space : 576 kombinasi\n",
      "Inner CV     : 5-Fold\n",
      "GridSearchCV selesai.\n",
      "Waktu GridSearch : 113.41 detik\n",
      "Best Inner CV Accuracy : 0.8898\n",
      "Best Hyperparameters:\n",
      "{'bootstrap': True, 'criterion': 'gini', 'max_depth': 20, 'max_features': 'sqrt', 'min_samples_leaf': 1, 'min_samples_split': 2, 'n_estimators': 300}\n",
      "\n",
      "[3/3] Mengevaluasi model optimized...\n",
      "Optimized Accuracy : 0.9000\n",
      "Optimized Macro F1 : 0.9001\n",
      "\n",
      "Menghitung permutation importance...\n",
      "\n",
      "Seed 99, Fold 5 selesai.\n",
      "\n",
      "\n",
      "################################################################################\n",
      "SELURUH NESTED CROSS-VALIDATION SELESAI\n",
      "################################################################################\n",
      "Jumlah outer experiment : 25\n",
      "Jumlah OOF prediction   : 5500\n",
      "Jumlah permutation rows : 500\n",
      "################################################################################\n"
     ]

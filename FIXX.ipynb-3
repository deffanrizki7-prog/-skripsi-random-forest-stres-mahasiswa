   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score\n",
    ")\n",
    "\n",
    "# ============================================================\n",
    "# 1. BACA FILE PREDIKSI OOF YANG SUDAH TERSIMPAN\n",
    "# ============================================================\n",
    "\n",
    "file_oof = \"out_of_fold_predictions.csv\"\n",
    "\n",
    "if not os.path.exists(file_oof):\n",
    "    raise FileNotFoundError(\n",
    "        f\"File {file_oof} tidak ditemukan di direktori kerja.\"\n",
    "    )\n",
    "\n",
    "oof_df = pd.read_csv(file_oof)\n",
    "\n",
    "print(\"=\" * 75)\n",
    "print(\"PEMERIKSAAN FILE PREDIKSI OOF\")\n",
    "print(\"=\" * 75)\n",
    "print(\"Nama file       :\", file_oof)\n",
    "print(\"Jumlah baris    :\", len(oof_df))\n",
    "print(\"Nama kolom      :\", oof_df.columns.tolist())\n",
    "\n",
    "display(oof_df.head())\n",
    "\n",
    "# ============================================================\n",
    "# 2. PERIKSA KELENGKAPAN KOLOM\n",
    "# ============================================================\n",
    "\n",
    "required_columns = [\n",
    "    \"seed\",\n",
    "    \"fold\",\n",
    "    \"index\",\n",
    "    \"y_true\",\n",
    "    \"baseline_pred\",\n",
    "    \"optimized_pred\"\n",
    "]\n",
    "\n",
    "if all(col in oof_df.columns for col in required_columns):\n",
    "\n",
    "    print(\"\\nStruktur kolom sesuai dengan format prediksi OOF.\")\n",
    "\n",
    "    print(\"Jumlah seed :\", oof_df[\"seed\"].nunique())\n",
    "    print(\"Jumlah fold :\", oof_df[\"fold\"].nunique())\n",
    "\n",
    "    # ========================================================\n",
    "    # 3. HITUNG ULANG METRIK DARI PREDIKSI YANG TERSIMPAN\n",
    "    # ========================================================\n",
    "\n",
    "    def hitung_metrik(y_true, y_pred):\n",
    "        return {\n",
    "            \"Jumlah prediksi benar\": int(\n",
    "                np.sum(np.asarray(y_true) == np.asarray(y_pred))\n",
    "            ),\n",
    "            \"Accuracy (%)\": accuracy_score(y_true, y_pred) * 100,\n",
    "            \"Precision Macro (%)\": precision_score(\n",
    "                y_true, y_pred,\n",
    "                average=\"macro\",\n",
    "                zero_division=0\n",
    "            ) * 100,\n",
    "            \"Recall Macro (%)\": recall_score(\n",
    "                y_true, y_pred,\n",
    "                average=\"macro\",\n",
    "                zero_division=0\n",
    "            ) * 100,\n",
    "            \"F1-Score Macro (%)\": f1_score(\n",
    "                y_true, y_pred,\n",
    "                average=\"macro\",\n",
    "                zero_division=0\n",
    "            ) * 100\n",
    "        }\n",
    "\n",
    "    baseline = hitung_metrik(\n",
    "        oof_df[\"y_true\"],\n",
    "        oof_df[\"baseline_pred\"]\n",
    "    )\n",
    "\n",
    "    optimized = hitung_metrik(\n",
    "        oof_df[\"y_true\"],\n",
    "        oof_df[\"optimized_pred\"]\n",
    "    )\n",
    "\n",
    "    hasil = pd.DataFrame({\n",
    "        \"Baseline\": baseline,\n",
    "        \"Optimized\": optimized\n",
    "    })\n",
    "\n",
    "    hasil[\"Selisih\"] = (\n",
    "        hasil[\"Optimized\"] - hasil[\"Baseline\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 75)\n",
    "    print(\"HASIL PERHITUNGAN ULANG METRIK OOF\")\n",
    "    print(\"=\" * 75)\n",
    "\n",
    "    display(hasil.round(6))\n",
    "\n",
    "    # ========================================================\n",
    "    # 4. BANDINGKAN DENGAN ANGKA DALAM SKRIPSI\n",
    "    # ========================================================\n",
    "\n",
    "    print(\"\\nPEMERIKSAAN ACCURACY TERHADAP DUA VERSI SKRIPSI\")\n",
    "\n",
    "    print(\n",
    "        \"Accuracy baseline aktual : \"\n",
    "        f\"{baseline['Accuracy (%)']:.6f}%\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Accuracy optimized aktual: \"\n",
    "        f\"{optimized['Accuracy (%)']:.6f}%\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Versi A di skripsi        : baseline 87.6727%, \"\n",
    "        \"optimized 87.5273%\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Versi B di skripsi        : baseline 87.6727%, \"\n",
    "        \"optimized 87.6909%\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "    print(\n",
    "        \"\\nKolom file berbeda dari format yang diharapkan.\"\n",
    "        \"\\nPeriksa nama kolom di atas sebelum menghitung metrik.\"\n",
    "    )"
   ]
  },

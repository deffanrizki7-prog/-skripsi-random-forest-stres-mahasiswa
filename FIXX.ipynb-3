    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Aturan keputusan:\n",
      "p-value < 0.05  -> perbedaan signifikan\n",
      "p-value >= 0.05 -> perbedaan tidak signifikan\n"
     ]
    }
   ],
   "source": [
    "# ============================================================\n",
    "# INTERPRETASI MCNEMAR TEST\n",
    "# ============================================================\n",
    "\n",
    "ALPHA = 0.05\n",
    "\n",
    "mcnemar_df[\"decision\"] = np.where(\n",
    "    mcnemar_df[\"p_value\"] < ALPHA,\n",
    "    \"Signifikan\",\n",
    "    \"Tidak signifikan\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"INTERPRETASI MCNEMAR TEST\")\n",
    "print(\"=\" * 100)\n",
    "\n",
    "display(\n",
    "    mcnemar_df[\n",
    "        [\n",
    "            \"seed\",\n",
    "            \"statistic\",\n",
    "            \"p_value\",\n",
    "            \"decision\"\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"\\nAturan keputusan:\")\n",
    "print(\"p-value < 0.05  -> perbedaan signifikan\")\n",
    "print(\"p-value >= 0.05 -> perbedaan tidak signifikan\")"
   ]
  },

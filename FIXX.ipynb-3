      "==========================================================================================\n",
      "NOTEBOOK: FIXX.ipynb\n",
      "==========================================================================================\n",
      "\n",
      "--- CELL 1 ---\n",
      "# ============================================================\n",
      "# CELL 1 — IMPORT LIBRARY\n",
      "# FINAL EXPERIMENT\n",
      "# Nested Stratified 5-Fold Cross Validation\n",
      "# ============================================================\n",
      "\n",
      "import time\n",
      "import platform\n",
      "import sys\n",
      "import warnings\n",
      "\n",
      "import numpy as np\n",
      "import pandas as pd\n",
      "\n",
      "import sklearn\n",
      "import statsmodels\n",
      "\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score,\n",
      "    confusion_matrix,\n",
      "    classification_report\n",
      ")\n",
      "from sklearn.inspection import permutation_importance\n",
      "\n",
      "from statsmodels.stats.contingency_tables import mcnemar\n",
      "\n",
      "import matplotlib.pyplot as plt\n",
      "\n",
      "warnings.filterwarnings(\"ignore\")\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"IMPORT LIBRARY BERHASIL\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "print(\"Python       :\", sys.version.split()[0])\n",
      "print(\"Scikit-learn :\", sklearn.__version__)\n",
      "print(\"Pandas       :\", pd.__version__)\n",
      "print(\"NumPy        :\", np.__version__)\n",
      "print(\"Statsmodels  :\", statsmodels.__version__)\n",
      "print(\"OS           :\", platform.system(), platform.release())\n",
      "print(\"Processor    :\", platform.processor())\n",
      "\n",
      "--- CELL 4 ---\n",
      "# ============================================================\n",
      "# KONFIGURASI EKSPERIMEN\n",
      "# ============================================================\n",
      "\n",
      "import time\n",
      "import sklearn\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# RANDOM SEED\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "RANDOM_SEEDS = [42, 1, 7, 24, 99]\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# JUMLAH FOLD\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# HYPERPARAMETER GRID\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200, 300, 500],\n",
      "    \"max_depth\": [10, 20, 30, None],\n",
      "    \"min_samples_split\": [2, 5, 10],\n",
      "    \"min_samples_leaf\": [1, 2, 4],\n",
      "    \"max_features\": [\"sqrt\"],\n",
      "    \"criterion\": [\"gini\", \"entropy\"],\n",
      "    \"bootstrap\": [True, False]\n",
      "}\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# JUMLAH KOMBINASI\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "jumlah_kombinasi = (\n",
      "    len(param_grid[\"n_estimators\"])\n",
      "    * len(param_grid[\"max_depth\"])\n",
      "    * len(param_grid[\"min_samples_split\"])\n",
      "    * len(param_grid[\"min_samples_leaf\"])\n",
      "    * len(param_grid[\"max_features\"])\n",
      "    * len(param_grid[\"criterion\"])\n",
      "    * len(param_grid[\"bootstrap\"])\n",
      ")\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# INFORMASI EKSPERIMEN\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"KONFIGURASI EKSPERIMEN\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "print(\"\\nRandom seed       :\", RANDOM_SEEDS)\n",
      "print(\"Outer Stratified K-Fold :\", N_SPLITS_OUTER)\n",
      "print(\"Inner Stratified K-Fold :\", N_SPLITS_INNER)\n",
      "\n",
      "print(\"\\nHyperparameter yang diuji:\")\n",
      "for parameter, values in param_grid.items():\n",
      "    print(f\"{parameter:20} : {values}\")\n",
      "\n",
      "print(\"\\nJumlah kombinasi hyperparameter :\", jumlah_kombinasi)\n",
      "\n",
      "print(\"\\nPerhitungan:\")\n",
      "print(\n",
      "    \"4 × 4 × 3 × 3 × 1 × 2 × 2 =\",\n",
      "    jumlah_kombinasi\n",
      ")\n",
      "\n",
      "print(\"\\nTotal outer experiment :\",\n",
      "      len(RANDOM_SEEDS) * N_SPLITS_OUTER)\n",
      "\n",
      "print(\"\\nVersi software:\")\n",
      "print(\"Python      :\", __import__(\"sys\").version)\n",
      "print(\"Pandas      :\", pd.__version__)\n",
      "print(\"NumPy       :\", np.__version__)\n",
      "print(\"Scikit-learn:\", sklearn.__version__)\n",
      "\n",
      "print(\"\\n\" + \"=\" * 70)\n",
      "print(\"KONFIGURASI SELESAI\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "--- CELL 5 ---\n",
      "# ============================================================\n",
      "# FUNGSI PERHITUNGAN METRIK\n",
      "# ============================================================\n",
      "\n",
      "from sklearn.metrics import (\n",
      "    accuracy_score,\n",
      "    precision_score,\n",
      "    recall_score,\n",
      "    f1_score\n",
      ")\n",
      "\n",
      "def calculate_metrics(y_true, y_pred):\n",
      "\n",
      "    return {\n",
      "        \"accuracy\": accuracy_score(\n",
      "            y_true,\n",
      "            y_pred\n",
      "        ),\n",
      "\n",
      "        \"precision_macro\": precision_score(\n",
      "            y_true,\n",
      "            y_pred,\n",
      "            average=\"macro\",\n",
      "            zero_division=0\n",
      "        ),\n",
      "\n",
      "        \"recall_macro\": recall_score(\n",
      "            y_true,\n",
      "            y_pred,\n",
      "            average=\"macro\",\n",
      "            zero_division=0\n",
      "        ),\n",
      "\n",
      "        \"f1_macro\": f1_score(\n",
      "            y_true,\n",
      "            y_pred,\n",
      "            average=\"macro\",\n",
      "            zero_division=0\n",
      "        )\n",
      "    }\n",
      "\n",
      "\n",
      "print(\"=\" * 70)\n",
      "print(\"FUNGSI METRIK BERHASIL DIBUAT\")\n",
      "print(\"=\" * 70)\n",
      "\n",
      "print(\"\\nMetrik yang digunakan:\")\n",
      "print(\"1. Accuracy\")\n",
      "print(\"2. Macro Precision\")\n",
      "print(\"3. Macro Recall\")\n",
      "print(\"4. Macro F1-score\")\n",
      "\n",
      "print(\"\\nMetrik utama GridSearchCV : Accuracy\")\n",
      "print(\"Fungsi metrik klasifikasi : Macro Average\")\n",
      "\n",
      "--- CELL 8 ---\n",
      "# ============================================================\n",
      "# PERSIAPAN PARAMETER NESTED STRATIFIED 5-FOLD CV\n",
      "# ============================================================\n",
      "\n",
      "# Random seeds\n",
      "RANDOM_SEEDS = [1, 7, 24, 42, 99]\n",
      "\n",
      "# Jumlah fold\n",
      "N_SPLITS_OUTER = 5\n",
      "N_SPLITS_INNER = 5\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# HYPERPARAMETER GRID\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "param_grid = {\n",
      "    \"n_estimators\": [100, 200, 300, 500],\n",
      "    \"max_depth\": [10, 20, 30, None],\n",
      "    \"min_samples_split\": [2, 5, 10],\n",
      "    \"min_samples_leaf\": [1, 2, 4],\n",
      "    \"max_features\": [\"sqrt\"],\n",
      "    \"criterion\": [\"gini\", \"entropy\"],\n",
      "    \"bootstrap\": [True, False]\n",
      "}\n",
      "\n",
      "# Hitung jumlah kombinasi\n",
      "jumlah_kombinasi = 1\n",
      "\n",
      "for values in param_grid.values():\n",
      "    jumlah_kombinasi *= len(values)\n",
      "\n",
      "# ------------------------------------------------------------\n",
      "# INFORMASI\n",
      "# ------------------------------------------------------------\n",
      "\n",
      "print(\"Random Seeds :\", RANDOM_SEEDS)\n",
      "print(\"Outer CV     :\", N_SPLITS_OUTER, \"Fold\")\n",
      "print(\"Inner CV     :\", N_SPLITS_INNER, \"Fold\")\n",
      "print(\"Jumlah kombinasi hyperparameter :\", jumlah_kombinasi)\n",
      "print(\n",
      "    \"Jumlah fitting per outer fold :\",\n",
      "    jumlah_kombinasi * N_SPLITS_INNER\n",
      ")\n",
      "print(\n",
      "    \"Total outer experiments :\",\n",
      "    len(RANDOM_SEEDS) * N_SPLITS_OUTER\n",
      ")\n",
      "\n",
      "--- CELL 9 ---\n",
      "# ============================================================\n",
      "# NESTED STRATIFIED 5-FOLD CROSS VALIDATION\n",
      "# 5 RANDOM SEEDS\n",
      "# ============================================================\n",
      "\n",
      "from sklearn.model_selection import StratifiedKFold, GridSearchCV\n",
      "from sklearn.ensemble import RandomForestClassifier\n",
      "from sklearn.inspection import permutation_importance\n",
      "import time\n",
      "\n",
      "# ============================================================\n",
      "# RESET STORAGE\n",
      "# ============================================================\n",
      "\n",
      "all_outer_results = []\n",
      "all_best_params = []\n",
      "all_oof_predictions = []\n",
      "all_permutation_results = []\n",
      "\n",
      "# ============================================================\n",
      "# LOOP RANDOM SEED\n",
      "# ============================================================\n",
      "\n",
      "for RANDOM_STATE in RANDOM_SEEDS:\n",
      "\n",
      "    print(\"\\n\")\n",
      "    print(\"#\" * 80)\n",
      "    print(f\"RANDOM SEED : {RANDOM_STATE}\")\n",
      "    print(\"#\" * 80)\n",
      "\n",
      "    # --------------------------------------------------------\n",
      "    # OUTER STRATIFIED 5-FOLD\n",
      "    # --------------------------------------------------------\n",
      "\n",
      "    outer_cv = StratifiedKFold(\n",
      "        n_splits=N_SPLITS_OUTER,\n",
      "        shuffle=True,\n",
      "        random_state=RANDOM_STATE\n",
      "    )\n",
      "\n",
      "    # --------------------------------------------------------\n",
      "    # LOOP OUTER FOLD\n",
      "    # --------------------------------------------------------\n",
      "\n",
      "    for fold, (train_idx, test_idx) in enumerate(\n",
      "        outer_cv.split(X, y),\n",
      "        start=1\n",
      "    ):\n",
      "\n",
      "        print(\"\\n\" + \"=\" * 75)\n",
      "        print(\n",
      "            f\"SEED {RANDOM_STATE} | \"\n",
      "            f\"OUTER FOLD {fold}/{N_SPLITS_OUTER}\"\n",
      "        )\n",
      "        print(\"=\" * 75)\n",
      "\n",
      "        # ----------------------------------------------------\n",
      "        # OUTER TRAINING & TESTING\n",
      "        # ----------------------------------------------------\n",
      "\n",
      "        X_train = X.iloc[train_idx].copy()\n",
      "        X_test = X.iloc[test_idx].copy()\n",
      "\n",
      "        y_train = y.iloc[train_idx].copy()\n",
      "        y_test = y.iloc[test_idx].copy()\n",
      "\n",
      "        print(f\"Training : {len(X_train)} data\")\n",
      "        print(f\"Testing  : {len(X_test)} data\")\n",
      "\n",
      "        # ----------------------------------------------------\n",
      "        # SAMPLE DATA TRAINING & TESTING\n",
      "        # ----------------------------------------------------\n",
      "\n",
      "        print(\"\\nSample Training Data:\")\n",
      "        display(\n",
      "            pd.concat(\n",
      "                [\n",
      "                    X_train,\n",
      "                    y_train.rename(\"stress_level\")\n",
      "                ],\n",
      "                axis=1\n",
      "            ).head(5)\n",
      "        )\n",
      "\n",
      "        print(\"\\nSample Testing Data:\")\n",
      "        display(\n",
      "            pd.concat(\n",
      "                [\n",
      "                    X_test,\n",
      "                    y_test.rename(\"stress_level\")\n",
      "                ],\n",
      "                axis=1\n",
      "            ).head(5)\n",
      "        )\n",
      "\n",
      "        # ====================================================\n",
      "        # 1. BASELINE\n",
      "        # ====================================================\n",
      "\n",
      "        print(\"\\n[1/3] Melatih Random Forest Baseline...\")\n",
      "\n",
      "        start_baseline = time.perf_counter()\n",
      "\n",
      "        baseline_model = RandomForestClassifier(\n",
      "            random_state=RANDOM_STATE\n",
      "        )\n",
      "\n",
      "        baseline_model.fit(\n",
      "            X_train,\n",
      "            y_train\n",
      "        )\n",
      "\n",
      "        baseline_pred = baseline_model.predict(\n",
      "            X_test\n",
      "        )\n",
      "\n",
      "        baseline_time = (\n",
      "            time.perf_counter() - start_baseline\n",
      "        )\n",
      "\n",
      "        baseline_metrics = calculate_metrics(\n",
      "            y_test,\n",
      "            baseline_pred\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Baseline Accuracy : \"\n",
      "            f\"{baseline_metrics['accuracy']:.4f}\"\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Baseline Macro F1 : \"\n",
      "            f\"{baseline_metrics['f1_macro']:.4f}\"\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Waktu Baseline    : \"\n",
      "            f\"{baseline_time:.2f} detik\"\n",
      "        )\n",
      "\n",
      "        # ====================================================\n",
      "        # 2. INNER STRATIFIED 5-FOLD + GRIDSEARCH\n",
      "        # ====================================================\n",
      "\n",
      "        print(\"\\n[2/3] Menjalankan GridSearchCV...\")\n",
      "\n",
      "        print(\n",
      "            f\"Search space : {jumlah_kombinasi} kombinasi\"\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Inner CV     : {N_SPLITS_INNER}-Fold\"\n",
      "        )\n",
      "\n",
      "        inner_cv = StratifiedKFold(\n",
      "            n_splits=N_SPLITS_INNER,\n",
      "            shuffle=True,\n",
      "            random_state=RANDOM_STATE\n",
      "        )\n",
      "\n",
      "        rf = RandomForestClassifier(\n",
      "            random_state=RANDOM_STATE\n",
      "        )\n",
      "\n",
      "        start_optimized = time.perf_counter()\n",
      "\n",
      "        grid_search = GridSearchCV(\n",
      "            estimator=rf,\n",
      "            param_grid=param_grid,\n",
      "            scoring=\"accuracy\",\n",
      "            cv=inner_cv,\n",
      "            n_jobs=-1,\n",
      "            refit=True\n",
      "        )\n",
      "\n",
      "        grid_search.fit(\n",
      "            X_train,\n",
      "            y_train\n",
      "        )\n",
      "\n",
      "        optimized_time = (\n",
      "            time.perf_counter() - start_optimized\n",
      "        )\n",
      "\n",
      "        print(\"GridSearchCV selesai.\")\n",
      "\n",
      "        print(\n",
      "            f\"Waktu GridSearch : \"\n",
      "            f\"{optimized_time:.2f} detik\"\n",
      "        )\n",
      "\n",
      "        print(\n",
      "            f\"Best Inner CV Accuracy : \"\n",
      "            f\"{gr\n",
      "\n",
      "--- CELL 13 ---\n",
      "# ============================================================\n",
      "# ANALISIS DISTRIBUSI BEST HYPERPARAMETER\n",
      "# ============================================================\n",
      "\n",
